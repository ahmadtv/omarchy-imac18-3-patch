[Unit]
Description=iMac18,3 fan curve daemon (the SMC does not ramp the fan under Linux)
Documentation=https://github.com/ahmadtv/omarchy-imac18-3-patch
ConditionPathExists=/sys/devices/platform/applesmc.768/fan1_manual
After=multi-user.target

[Service]
Type=simple
ExecStart=/usr/local/bin/imac-fand
# Hand fan control back to the SMC if this daemon ever stops.
ExecStopPost=/usr/bin/sh -c 'echo 0 > /sys/devices/platform/applesmc.768/fan1_manual 2>/dev/null || true'
Restart=always
RestartSec=5
# Environment=IMAC_FAND_POLL=5
# Environment=IMAC_FAND_HYSTERESIS=3

[Install]
WantedBy=multi-user.target
