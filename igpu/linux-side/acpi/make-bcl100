#!/usr/bin/env bash
#
# make-bcl100 -- give Linux the panel's full brightness range on the iMac18,3.
#
# The firmware's ACPI brightness table (_BCL = ABCL in Apple's SSDT "PEG0GFX0")
# lists levels 1..80, while its own setter BSET(level) scales 655*level onto the
# backlight controller's 0..0xFFFF range -- so Linux's 100% is BSET(80) = 52400,
# 80% of what macOS drives (macOS: 0..65535, 500 nits). This reads the machine's
# own table, rewrites only ABCL to levels 4..100 (below 4 is under macOS's usable
# floor, ~2176 raw), bumps the OEM revision so the kernel prefers the upgrade,
# and compiles it for mkinitcpio's acpi_override hook. Apple's table never
# leaves the machine. Needs root and iasl (acpica).
#   sudo igpu/linux-side/acpi/make-bcl100 [out.aml]
set -euo pipefail
# Name after kernel/firmware/acpi/ must stay under 18 bytes (lib/earlycpio.c MAX_CPIO_FILE_NAME).
OUT=${1:-/etc/initcpio/acpi_override/imac-bcl100.aml}
W=$(mktemp -d); trap 'rm -rf "$W"' EXIT; cd "$W"
for t in /sys/firmware/acpi/tables/DSDT /sys/firmware/acpi/tables/SSDT*; do cat "$t" > "$(basename "$t").dat"; done
T=$(grep -l 'PEG0GFX0' SSDT*.dat | head -1) || { echo "no PEG0GFX0 SSDT on this machine"; exit 1; }
iasl -e DSDT.dat $(ls SSDT*.dat | grep -vx "$T") -d "$T" >/dev/null 2>&1
rc=0; python3 - "${T%.dat}.dsl" <<'PY' || rc=$?
import re, sys
p = sys.argv[1]; s = open(p).read()
s, n = re.subn(r'("PEG0GFX0", )0x([0-9A-F]{8})\)', lambda m: '%s0x%08X)' % (m.group(1), int(m.group(2), 16) + 1), s, count=1)
assert n == 1, "DefinitionBlock header not found"
m = re.search(r'(Method \(ABCL, 0, NotSerialized\)\s*\{\s*Return \(Package \()0x[0-9A-F]+(\)\s*\{)(.*?)(\}\))', s, re.S)
assert m, "ABCL not found"
old = [v.strip() for v in m.group(3).replace('\n', ' ').split(',') if v.strip()]
if old[0] == '0x64' and len(old) == 2 + 97:
    sys.exit(3)          # this boot already runs the upgraded table
assert old[0] == '0x50' and len(old) == 0x52, "unexpected ABCL: a different firmware?"
levels = list(range(4, 101))
body = ",\n                    ".join(['0x64', '0x32'] + ['0x%02X' % i for i in levels])
s = s[:m.start()] + m.group(1) + '0x%02X' % (2 + len(levels)) + m.group(2) + '\n                    ' + body + '\n                ' + m.group(4) + s[m.end():]
open(p, 'w').write(s)
PY
if ((rc == 3)); then
  # Booted with the override already: the loaded table is exactly the output.
  install -Dm644 "$T" "$OUT"; echo "wrote $OUT ($(stat -c %s "$OUT") bytes): copied the already-upgraded table"; exit 0
fi
((rc == 0)) || exit "$rc"
iasl -p out "${T%.dat}.dsl" >iasl.log 2>&1 || { grep -E "^Error" iasl.log; exit 1; }
install -Dm644 out.aml "$OUT"; echo "wrote $OUT ($(stat -c %s "$OUT") bytes): ABCL levels 4..100"
