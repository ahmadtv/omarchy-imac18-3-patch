#!/bin/sh
# DRAFT — not installed.   Target: /usr/local/bin/imac-greeter-compositor (0755)
# OPTIONAL. Used by 20-imac-greeter-gpu.conf.
#
# The SDDM greeter runs its own Hyprland (as the sddm user) with
# /usr/share/sddm/hyprland.lua (omarchy-settings), which never reads
# ~/.config/hypr, so the session's AQ_DRM_DEVICES pin does not reach it.
# Without a pin the greeter's aquamarine still takes the boot_vga Radeon as
# primary (the HD 630 has no connected eDP under i915.disable_display=1), and
# merely opens the Intel card as an idle secondary GPU. With autologin the
# greeter only shows after a logout or a GPU-reset recovery -- so this is a
# tidiness item, not a correctness one.
#
# Same guard as the session snippet: pin only when the iGPU exists and the udev
# link is there; a missing path in AQ_DRM_DEVICES would leave no GPU at all.
if [ -e /sys/bus/pci/devices/0000:00:02.0 ] && [ -e /dev/dri/amd-card ]; then
	AQ_DRM_DEVICES=/dev/dri/amd-card
	export AQ_DRM_DEVICES
fi
exec /usr/bin/start-hyprland "$@"
