+	/* Both tiles are timing-identical; mirror the validated root stream. */
+	peer->timing = root_stream->timing;
+	peer->src = root_stream->src;
+	peer->dst = root_stream->dst;
+	peer->output_color_space = root_stream->output_color_space;
+
+	return peer;
