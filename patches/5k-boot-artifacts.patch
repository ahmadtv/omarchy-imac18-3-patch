+/*
+ * Return the Apple 5K dual-tile panel to its factory single-link state.
+ *
+ * The tiled-stitch paths wake the slave tile with a vendor DPCD write and never
+ * clear it, so the woken state survives a warm reboot into Apple's firmware,
+ * which then draws its boot logo skewed. Clear the latch while AUX still works:
+ * on shutdown/reboot (amdgpu_pci_shutdown) and on module unload (below).
+ *
+ * No-op on hardware without the tiled-panel quirk.
+ */
+void amdgpu_dm_apple5k_panel_latch_teardown(struct amdgpu_device *adev)
+{
+	if (!adev || !adev->dm.dc)
+		return;
+
+	dc_apple_5k_panel_latch_teardown(adev->dm.dc);
+}
+
+/*
+ * True when this device drives an Apple dual-tile panel through the tiled
+ * stitch, i.e. one crtc feeds a root tile stream plus a peer slave-tile stream.
+ *
+ * The peer stream only comes into existence during an atomic modeset (see the
+ * stitch block in amdgpu_dm_atomic_check), so until the first commit lands the
+ * panel is presenting a full-width mode with only the root tile scanning out.
+ * The probe path uses this to force that first commit early rather than leaving
+ * the right-hand tile dark until something else happens to trigger a modeset.
+ */
+bool amdgpu_dm_has_tiled_stitch_panel(struct amdgpu_device *adev)
+{
+	int i;
+
+	if (!adev || !adev->dm.dc)
+		return false;
+
+	for (i = 0; i < adev->dm.dc->link_count; i++)
+		if (amdgpu_dm_link_is_tiled_stitch_root(adev->dm.dc->links[i]))
+			return true;
+
+	return false;
+}
+
 static void amdgpu_dm_fini(struct amdgpu_device *adev)
 {
 	int i;
 
+	amdgpu_dm_apple5k_panel_latch_teardown(adev);
+
 	if (adev->dm.vblank_control_workqueue) {
 		destroy_workqueue(adev->dm.vblank_control_workqueue);
 		adev->dm.vblank_control_workqueue = NULL;
