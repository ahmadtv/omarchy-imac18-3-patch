+/*
+ * Apple 5K dual-tile panel teardown.
+ *
+ * The tiled-stitch paths wake the slave tile by writing the vendor panel-latch
+ * DPCD (0x4F1 = 1) and never clear it. Apple's firmware assumes the factory
+ * single-link state on the next boot, so after a warm reboot it draws its boot
+ * logo into a panel configuration it does not expect and the logo comes out
+ * skewed. Clearing the latch on the way down restores that state.
+ *
+ * Called from the shutdown/reboot path and from module unload, while AUX is
+ * still usable. No-op on any machine without the tiled-panel quirk.
+ */
+void dc_apple_5k_panel_latch_teardown(struct dc *dc)
+{
+	int i;
+
+	if (!dc)
+		return;
+
+	for (i = 0; i < dc->link_count; i++) {
+		struct dc_link *link = dc->links[i];
+
+		if (!dc_link_has_tiled_root_panel_patch(link))
+			continue;
+
+		DC_LOG_DC("APPLE5K: panel latch teardown 0x4F1=0 root_link[%u] status=%d\n",
+			  link->link_index,
+			  link_apple_5k_root_panel_latch_clear(link));
+	}
+}
