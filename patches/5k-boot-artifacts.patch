 	}
 
 	ret = amdgpu_debugfs_init(adev);
@@ -2581,6 +2604,9 @@
 	 */
 	if (!amdgpu_passthrough(adev))
 		adev->mp1_state = PP_MP1_STATE_UNLOAD;
+	/* Apple 5K dual-tile panel: the display teardown below clears the panel
+	 * latch on stream disable; stop the wake paths from undoing it. */
+	amdgpu_dm_apple5k_going_down(adev);
 	amdgpu_device_prepare(dev);
 	amdgpu_device_suspend(dev, true);
 	adev->mp1_state = PP_MP1_STATE_NONE;
--- a/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm.c
+++ b/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm.c
@@ -2988,6 +2988,41 @@
 	return 0;
 }
 
+/*
+ * The machine is going down for firmware. From here on the Apple 5K tile wake
+ * paths are no-ops, so the latch clear done on stream disable is not undone by
+ * the HPD-RX re-detect the panel raises in response. See dc.apple_5k_going_down.
+ */
+void amdgpu_dm_apple5k_going_down(struct amdgpu_device *adev)
+{
+	if (adev && adev->dm.dc)
+		adev->dm.dc->apple_5k_going_down = true;
+}
+
+/*
+ * True when this device drives an Apple dual-tile panel through the tiled
+ * stitch, i.e. one crtc feeds a root tile stream plus a peer slave-tile stream.
+ *
+ * The peer stream only comes into existence during an atomic modeset (see the
+ * stitch block in amdgpu_dm_atomic_check), so until the first commit lands the
+ * panel is presenting a full-width mode with only the root tile scanning out.
+ * The probe path uses this to force that first commit early rather than leaving
+ * the right-hand tile dark until something else happens to trigger a modeset.
+ */
+bool amdgpu_dm_has_tiled_stitch_panel(struct amdgpu_device *adev)
+{
+	int i;
+
+	if (!adev || !adev->dm.dc)
+		return false;
+
+	for (i = 0; i < adev->dm.dc->link_count; i++)
+		if (amdgpu_dm_link_is_tiled_stitch_root(adev->dm.dc->links[i]))
+			return true;
+
+	return false;
+}
+
 static void amdgpu_dm_fini(struct amdgpu_device *adev)
 {
 	int i;
--- a/drivers/gpu/drm/amd/display/dc/dc.h
+++ b/drivers/gpu/drm/amd/display/dc/dc.h
@@ -1800,6 +1800,14 @@
 	struct dc_phy_addr_space_config vm_pa_config;
 
 	uint8_t link_count;
+
+	/* Apple 5K dual-tile panel: set once the machine is going down for
+	 * firmware (PCI shutdown). Clearing the panel latch makes the panel raise
+	 * HPD-RX, and the detect path would otherwise wake the tile straight
+	 * back up -- within 2-10 ms on hardware -- so the firmware inherits a
+	 * woken tile and draws its boot logo skewed. Once set, the wake paths
+	 * are no-ops and the latch stays cleared. */
+	bool apple_5k_going_down;
 	struct dc_link *links[MAX_LINKS];
 	uint8_t lowest_dpia_link_index;
 	struct link_service *link_srv;
--- a/drivers/gpu/drm/amd/display/dc/link/link_dpms.c
+++ b/drivers/gpu/drm/amd/display/dc/link/link_dpms.c
@@ -91,6 +91,10 @@
 	if (!dc_link_needs_tiled_stream_enable_latch(link) || !link->local_sink)
 		return;
 
+	/* Going down: leave the panel in its cold-boot state for the firmware. */
+	if (link->dc && link->dc->apple_5k_going_down)
+		return;
+
 	DC_LOGGER_INIT(link->ctx->logger);
 
 	root_link = link->tiled_peer;
@@ -115,6 +119,41 @@
 		    link->local_sink);
 }
 
+/*
+ * Mirror of dp_write_tiled_stream_enable_latch(): clear the panel latch when
+ * the slave tile stream is turned off. Apple's firmware assumes the factory
+ * single-link state on the next boot; leaving 0x4F1 = 1 behind across a warm
+ * reboot makes it draw the boot logo into a dual-tile panel and skew it.
+ *
+ * Done here, on the stream-disable path, rather than at PCI shutdown: by this
+ * point the stream is already blanked, so there is nothing on screen to skew,
+ * and AUX is still up because disable_link() has not run yet. Every modeset
+ * then leaves the panel exactly as a cold boot found it, and the existing
+ * wake/train/enable-latch sequence brings it back.
+ */
+static void dp_write_tiled_stream_disable_latch(struct dc_link *link)
+{
+	struct dc_link *root_link;
+	uint8_t payload = 0;
+	enum dc_status status;
+	enum dc_status root_status = DC_OK;
+
+	if (!dc_link_needs_tiled_stream_enable_latch(link) || !link->local_sink)
+		return;
+
+	DC_LOGGER_INIT(link->ctx->logger);
+
+	root_link = link->tiled_peer;
+	if (dc_link_has_tiled_root_panel_patch(root_link))
+		root_status = link_apple_5k_root_panel_latch_clear(root_link);
+
+	status = core_link_write_dpcd(link, APPLE_5K_DPCD_PANEL_LATCH,
+				      &payload, sizeof(payload));
+	DC_LOG_INFO("APPLE5K: stream-disable latch 0x4F1=0 link[%u] status=%d root_link[%d] root_status=%d\n",
+		    link->link_index, status,
+		    root_link ? (int)root_link->link_index : -1, root_status);
+}
+
 void link_blank_all_dp_displays(struct dc *dc)
 {
 	unsigned int i;
@@ -2244,6 +2283,10 @@
 	update_psp_stream_config(pipe_ctx, true);
 	dc->hwss.blank_stream(pipe_ctx);
 
+	/* Stream is dark now and the link is still up: return the Apple 5K
+	 * panel latch to its cold-boot state before the link goes away. */
+	dp_write_tiled_stream_disable_latch(link);
+
 	if (pipe_ctx->link_config.dp_tunnel_settings.should_use_dp_bw_allocation)
 		deallocate_usb4_bandwidth(pipe_ctx->stream);
 
--- a/drivers/gpu/drm/amd/display/dc/link/protocols/link_dpcd.c
+++ b/drivers/gpu/drm/amd/display/dc/link/protocols/link_dpcd.c
@@ -261,6 +261,28 @@
 	if (!dc_link_has_tiled_root_panel_patch(root_link))
 		return DC_OK;
 
+	/* Going down: leave the panel in its cold-boot state for the firmware. */
+	if (root_link->dc && root_link->dc->apple_5k_going_down)
+		return DC_OK;
+
+	return core_link_write_dpcd(root_link, APPLE_5K_DPCD_ROOT_PANEL_LATCH,
+				    &payload, sizeof(payload));
+}
+
+/*
+ * Teardown counterpart of the pulse above. Apple's firmware expects the panel
+ * back in its factory single-link state at power-off/reboot; we wake the slave
+ * tile and, without this, never put it back. A warm reboot then hands the
+ * firmware a panel configuration it does not expect, which is what skews the
+ * boot logo. Cold boot is unaffected because the panel is power-cycled.
+ */
+enum dc_status link_apple_5k_root_panel_latch_clear(struct dc_link *root_link)
+{
+	uint8_t payload = 0;
+
+	if (!dc_link_has_tiled_root_panel_patch(root_link))
+		return DC_OK;
+
 	return core_link_write_dpcd(root_link, APPLE_5K_DPCD_ROOT_PANEL_LATCH,
 				    &payload, sizeof(payload));
 }
--- a/drivers/gpu/drm/amd/display/dc/link/protocols/link_dpcd.h
+++ b/drivers/gpu/drm/amd/display/dc/link/protocols/link_dpcd.h
@@ -47,4 +47,11 @@
  */
 enum dc_status link_apple_5k_root_panel_latch_pulse(struct dc_link *root_link);
 
+/*
+ * Clear the Apple 5K root panel-latch DPCD (0x4F1 = 0), returning the panel to
+ * its factory single-link state. Called on shutdown/reboot and module unload.
+ * Safe to call with NULL or non-root link -- no-op.
+ */
+enum dc_status link_apple_5k_root_panel_latch_clear(struct dc_link *root_link);
+
 #endif
