@@ -2478,6 +2479,28 @@
 			format = NULL;
 
 		drm_client_setup(adev_to_drm(adev), format);
+
+		/*
+		 * Apple dual-tile panels: the slave tile only gets a stream
+		 * during an atomic modeset, and drm_client_setup()'s initial
+		 * fbdev config deliberately stops short of committing one --
