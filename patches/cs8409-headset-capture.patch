+// Clamp a gain index to what the nid's input amp actually implements.
+//
+// cs_8409_intmike_volume_setup uses the same 0x27 for the ADC and for the
+// internal mike pin, but the pin (0x45 on the iMacs, 0x44 on the MacBook Pros)
+// is a 2 step boost - AC_PAR_AMP_IN_CAP reports nsteps 2. Writing 0x27 leaves
+// the low bits behind in the register, so ALSA reads back 3 on a control whose
+// max is 2. WirePlumber then fails "Failed to set volume of 'Internal Mic
+// Boost': Invalid argument" and drops the whole analog device.
+static int cs_8409_amp_in_clamp(struct hda_codec *codec, hda_nid_t nid, int volume)
+{
+        unsigned int caps;
+        int nsteps;
+
+        caps = snd_hda_param_read(codec, nid, AC_PAR_AMP_IN_CAP);
+        if (caps == (unsigned int)-1 || !caps)
+                return volume;
+
+        nsteps = (caps & AC_AMPCAP_NUM_STEPS) >> AC_AMPCAP_NUM_STEPS_SHIFT;
+        if (nsteps > 0 && volume > nsteps)
+                return nsteps;
+
+        return volume;
+}
