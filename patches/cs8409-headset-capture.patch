 {
         int retgain;
         int newgain;
+        int gain;
 
         struct cs8409_apple_spec *spec = codec->spec;
 
+        // the ADC gain comes from the mixer control (or intmike_gain before it
+        // exists), not from the hardcoded OSX constant - see above
+        gain = cs_8409_intmike_adc_gain(codec, volume);
+
