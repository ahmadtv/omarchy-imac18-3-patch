+/*
+ * Headset (earbud) microphone gain.
+ *
+ * The CS42L83 is the only place any gain exists on this path: the HDA widget
+ * for the headset ADC (0x1a) has no Amp-In at all, so ALSA exposes no control
+ * for it and the user cannot turn it up. Left at the codec's reset values the
+ * earbud mike measured 35x quieter than the internal one -- peak 0.0253 versus
+ * 0.905, a 31 dB shortfall.
+ *
+ * Two stages, both digital, both inside the CS42L83, per the CS42L42 datasheet
+ * (DS1083F8 sections 4.1 and 7.11.3 -- the CS42L83 is the same silicon family
+ * and mainline's sound/soc/codecs/cs42l42.c agrees on the register map):
+ *
+ *   0x1D01 bit 0  ADC_DIG_BOOST  +20 dB, reset value 0 (off)
+ *   0x1D03        ADC_VOL        two's complement, 1.0 dB steps,
+ *                                +12 dB (0x0C) .. -96 dB (0xA0), 0x00 = 0 dB
+ *
+ * That is +32 dB available in total, which is almost exactly the measured
+ * shortfall -- the whole deficit is gain nobody was applying.
+ *
+ * Note macOS does NOT do this. davidjo's trace of
+ * AppleHDATDM_CS42L83::enableExtMicrophone (see the function below) shows OSX
+ * writing 0x1d03 = 0x00 and never touching 0x1d01, leaving both stages at
+ * reset. Its loudness comes from CoreAudio applying gain in software, which has
+ * no register equivalent. So we are deliberately going beyond what OSX writes,
+ * and that is correct rather than a workaround.
+ *
+ * Both stages are applied after the ADC, so they are pure digital gain: they
+ * lift the noise floor with the signal and do not improve signal-to-noise.
+ * Measured 28 dB SNR either way -- that figure belongs to the earbud mike and
+ * Apple's analogue path, not to these settings.
+ *
+ * Defaults are boost on plus the full +12 dB trim. In testing a normal speaking
+ * voice sat at -21.7 dBFS with peaks at -8.9 dBFS and no clipped samples.
+ * Do not raise the trim further: at +32 dB a plosive close to the mike reaches
+ * 0 dBFS and hard-clips.
+ */
+static int headset_mike_boost = 1;
+module_param(headset_mike_boost, int, 0644);
+MODULE_PARM_DESC(headset_mike_boost, "headset mike ADC_DIG_BOOST: 1 = +20 dB (default), 0 = off");
+
+static int headset_mike_gain = 12;
+module_param(headset_mike_gain, int, 0644);
+MODULE_PARM_DESC(headset_mike_gain, "headset mike ADC_VOL in dB, -96..+12 (default +12)");
+
+/*
+ * Apply the two gain stages. Must run after cs42l83_headset_mike_adc_unmutevol(),
+ * which writes 0x1d03 = 0x00 (unmute at 0 dB) and would otherwise undo the trim.
+ */
+static void cs42l83_headset_mike_adc_level(struct hda_codec *codec)
+{
+	int gain = headset_mike_gain;
+	unsigned int vol;
+
+	if (gain > 12)
+		gain = 12;
+	if (gain < -96)
+		gain = -96;
+
+	/* two's complement in 1.0 dB steps; 0x00 is 0 dB */
+	vol = (unsigned int)(gain & 0xff);
+
+	cs_8409_vendor_i2cWrite(codec, 0x90, 0x1d01, headset_mike_boost ? 0x0001 : 0x0000, 1);
+	cs_8409_vendor_i2cWrite(codec, 0x90, 0x1d03, vol, 1);
+
+	codec_info(codec, "cs42l83_headset_mike_adc_level: boost %d gain %d dB (0x1d01 0x%02x 0x1d03 0x%02x)\n",
+		   headset_mike_boost, gain, headset_mike_boost ? 1 : 0, vol);
+}
