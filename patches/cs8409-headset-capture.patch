 					}
 				}
-				// I think this is impossible - this would say we tried to capture
-				// using a headset without mike
+				else
+				{
+					// headset/headphones with no mike (3 pole plug) - fall back to
+					// the internal mike so capture still works while plugged in
+					cs_8409_capture_setup(codec);
+				}
 				// NOTE - still not fixed linein/lineout working - this may need
 				// changing here
 			}
@@ -1927,6 +2039,8 @@ static void cs_8409_capture_pcm_hook(struct hda_pcm_stream *hinfo, struct hda_co
 		spec->capture_init_count = 0;
 		// not sure of this position yet
 		spec->capturing = 0;
+		// the saved prepare arguments are stale from here on
+		spec->capture_hinfo = NULL;
 		power_chk = snd_hda_codec_read(codec, codec->core.afg, 0, AC_VERB_GET_POWER_STATE, 0);
 		myprintk("snd_hda_intel: command cs_8409_capture_pcm_hook power check 0x01 4 %d", power_chk);
 		myprintk("snd_hda_intel: command cs_8409_capture_pcm_hook HOOK CLEANUP end");
diff --git i/patch_cirrus/patch_cirrus_real84.h w/patch_cirrus/patch_cirrus_real84.h
index 76de5e8..7dddf82 100644
--- i/patch_cirrus/patch_cirrus_real84.h
+++ w/patch_cirrus/patch_cirrus_real84.h
@@ -282,13 +282,100 @@ static void cs_8409_linein_volume_setup_new(struct hda_codec *codec, int volume)
 }
 
 
+// Clamp a gain index to what the nid's input amp actually implements.
+//
+// cs_8409_intmike_volume_setup uses the same 0x27 for the ADC and for the
+// internal mike pin, but the pin (0x45 on the iMacs, 0x44 on the MacBook Pros)
+// is a 2 step boost - AC_PAR_AMP_IN_CAP reports nsteps 2. Writing 0x27 leaves
+// the low bits behind in the register, so ALSA reads back 3 on a control whose
+// max is 2. WirePlumber then fails "Failed to set volume of 'Internal Mic
+// Boost': Invalid argument" and drops the whole analog device.
+static int cs_8409_amp_in_clamp(struct hda_codec *codec, hda_nid_t nid, int volume)
+{
+        unsigned int caps;
+        int nsteps;
+
+        caps = snd_hda_param_read(codec, nid, AC_PAR_AMP_IN_CAP);
+        if (caps == (unsigned int)-1 || !caps)
+                return volume;
+
+        nsteps = (caps & AC_AMPCAP_NUM_STEPS) >> AC_AMPCAP_NUM_STEPS_SHIFT;
+        if (nsteps > 0 && volume > nsteps)
+                return nsteps;
+
+        return volume;
+}
+
+
+// Internal mike capture level.
+//
+// The OSX replay calls cs_8409_intmike_volume_setup(codec, 0x27) at every point
+// the internal mike is brought up - boot, capture start, headset unplug. Node
+// 0x23 (0x22 on the MacBook Pros) has Amp-In caps ofs=0x33 nsteps=0x3f
+// stepsize=0x03 mute=1, ie 1.0 dB a step with 0 dB sitting at index 0x33. So
+// 0x27 is -12 dB, and it was being stamped over the amp on every capture setup
+// while "Internal Mic Capture Volume" simultaneously read back 63 [100%]
+// [12.00dB] - a 24 dB lie, and a mixer control that did nothing. Measured on an
+// iMac18,3 with someone talking: 0x27 gave -40.6 dBFS (unusable), 0x3f gave
+// -26.2 dBFS RMS / -14.1 dBFS peak (good).
+//
+// The fix is to stop overriding userspace rather than just to raise the
+// constant. Once "Internal Mic Capture Volume" exists the control owns the amp:
+// we re-read whatever value ALSA holds for it and write that back, so the write
+// is a no-op refresh instead of a reset and PipeWire/WirePlumber can actually
+// manage the level. Before the mixer is built - the boot setup call happens
+// during codec init, well before build_controls - there is no control to
+// consult, so intmike_gain seeds it. Default 0x3f (+12 dB), the value that
+// measured well; 0x33 is 0 dB, which is what upstream PR #197 moves its
+// CS8409_CAPTURE_INPUT_GAIN_DEFAULT to. Setting intmike_gain to a negative
+// value restores the old hardcoded behaviour.
+//
+// Note the line-in path (cs_8409_linein_volume_setup) is deliberately left at
+// 0x27. PR #197 raises both, but line-in here is a line level input on the back
+// of the machine with nothing measured through it, and +24 dB on a line level
+// source is a good way to clip it.
+//
+// Only the ADC nid is affected. The internal mike pin nid keeps being passed the
+// original constant through cs_8409_amp_in_clamp - it is a 0..2 boost with its
+// own "Internal Mic Boost" control and must not get dragged around by the ADC
+// control.
+
+static int intmike_gain = 0x33;
+module_param(intmike_gain, int, 0644);
+MODULE_PARM_DESC(intmike_gain, "internal mike ADC input amp gain index used until the mixer exists, 0-0x3f, 0x33 = 0dB (default 0x33); negative = old hardcoded behaviour");
+
+static int cs_8409_intmike_adc_gain(struct hda_codec *codec, int volume)
+{
+        struct cs8409_apple_spec *spec = codec->spec;
+        int val;
+
+        // once the mixer control is there it is the authority on this amp
+        if (snd_hda_find_mixer_ctl(codec, "Internal Mic Capture Volume")) {
+                val = snd_hda_codec_amp_read(codec, spec->intmike_adc_nid, 0,
+                                             HDA_INPUT, 0);
+                if (val >= 0)
+                        return val & 0x7f;
+        }
+
+        if (intmike_gain >= 0)
+                return cs_8409_amp_in_clamp(codec, spec->intmike_adc_nid,
+                                            intmike_gain & 0x7f);
+
+        return volume;
+}
+
