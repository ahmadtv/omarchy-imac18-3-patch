diff --git i/patch_cirrus/patch_cirrus_new84.h w/patch_cirrus/patch_cirrus_new84.h
index a40a6f5..942442f 100644
--- i/patch_cirrus/patch_cirrus_new84.h
+++ w/patch_cirrus/patch_cirrus_new84.h
@@ -1007,6 +1007,114 @@ static void switch_input_src(struct hda_codec *codec)
 
 
 
+// Re-run the capture ADC selection and setup for the CURRENT jack state.
+//
+// cs_8409_capture_pcm_prepare chooses the capture ADC - headset mike on 0x1a
+// versus the internal mike on intmike_adc_nid - exactly once, when the stream
+// starts. A headset plug or unplug while a capture stream is already open used
+// to do nothing at all ("PLUGIN WHILE CAPTURING UNIMPLEMENTED"), leaving the
+// stream bound to an ADC that is no longer the one being driven, ie silence,
+// with no recovery until the recording application closed and reopened the
+// device. This redoes that selection using the prepare arguments saved in the
+// spec, mirroring the prepare path step for step:
+//   cleanup the old ADC stream -> point hinfo at the new ADC ->
+//   cache the stream parameters against the new nid (must be BEFORE the setup,
+//   or cs_8409_really_update_stream_format finds an empty cache) ->
+//   run the same setup the pre prepare hook would have run -> setup the stream.
+//
+// CONTEXT: this is called from the cs42l83 plug/unplug handlers, which run out
+// of the HDA bus unsolicited response work item, ie process context - the code
+// surrounding both call sites already does msleep() and long blocking i2c
+// sequences. So the sleeping setup helpers can be called directly here and
+// deferring to another work item would only add a cancel/lifetime problem on
+// module unload for no benefit.
+static void cs_8409_capture_follow_jack(struct hda_codec *codec)
+{
+	struct cs8409_apple_spec *spec = codec->spec;
+	struct hda_pcm_stream *hinfo;
+	hda_nid_t want_nid, old_nid;
+	int saved_block_unsol;
+
+	// nothing open - the next cs_8409_capture_pcm_prepare will get it right
+	if (!spec->capturing)
+		return;
+
+	hinfo = spec->capture_hinfo;
+	if (hinfo == NULL)
+		return;
+
+	old_nid = hinfo->nid;
+
+	if (spec->jack_present && spec->have_mike)
+		want_nid = 0x1a;
+	else
+		want_nid = spec->intmike_adc_nid;
+
+	// only ever move between the two ADCs we know how to set up
+	if (old_nid != 0x1a && old_nid != spec->intmike_adc_nid)
+	{
+		dev_info(hda_codec_dev(codec),
+		         "cs_8409_capture_follow_jack: unexpected capture nid 0x%02x - not touching\n",
+		         old_nid);
+		return;
+	}
+
+	if (old_nid == want_nid)
+	{
+		dev_info(hda_codec_dev(codec),
+		         "cs_8409_capture_follow_jack: already on nid 0x%02x - nothing to do\n",
+		         old_nid);
+		return;
+	}
+
+	dev_info(hda_codec_dev(codec),
+	         "cs_8409_capture_follow_jack: capture nid 0x%02x -> 0x%02x (jack %d mike %d)\n",
+	         old_nid, want_nid, spec->jack_present, spec->have_mike);
+
+	// we are running inside an unsolicited response - the setup helpers below
+	// manage block_unsol themselves and leave it clear, so put it back after
+	saved_block_unsol = spec->block_unsol;
+
+	// take the DMA stream off the old ADC before pointing the PCM elsewhere
+	snd_hda_codec_cleanup_stream(codec, old_nid);
+
+	hinfo->nid = want_nid;
+
+	cs_8409_store_stream_format(codec, want_nid, spec->capture_stream_tag, spec->capture_format);
+
+	if (want_nid == 0x1a)
+	{
+		// headset mike - note the headphone/ASP setup is needed even when we
+		// are only capturing (cs42l83_configure_serial_port sets the primary
+		// ASP receive frequency), same as cs_8409_pcm_capture_pre_prepare_hook
+		if (spec->headset_play_format_setup_needed)
+		{
+			cs_8409_headplay_setup(codec);
+			spec->headset_play_format_setup_needed = 0;
+		}
+		if (spec->headset_capture_format_setup_needed)
+		{
+			cs_8409_headcapture_setup(codec);
+			spec->headset_capture_format_setup_needed = 0;
+		}
+	}
+	else
+	{
+		// internal mike - the unplug sequence has already torn the cs42l83
+		// mike path down and left the input nids powered off, so this brings
+		// them back up exactly as a fresh capture start would
+		cs_8409_capture_setup(codec);
+	}
+
+	snd_hda_codec_setup_stream(codec, want_nid, spec->capture_stream_tag, 0, spec->capture_format);
+
+	spec->block_unsol = saved_block_unsol;
+
+	dev_info(hda_codec_dev(codec),
+	         "cs_8409_capture_follow_jack: capture now on nid 0x%02x\n", want_nid);
+}
+
