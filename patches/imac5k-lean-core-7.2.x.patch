+/* The tiles advertise scaled fallbacks as preferred; prefer the tile-native mode. */
+static void amdgpu_dm_prefer_tile_mode(struct drm_connector *connector)
+{
+	struct drm_display_mode *mode, *tile = NULL;
+
+	if (!dc_link_is_apple_tiled(to_amdgpu_dm_connector(connector)->dc_link))
+		return;
+	list_for_each_entry(mode, &connector->probed_modes, head)
+		if (amdgpu_dm_mode_is_tile_size(connector, mode)) {
+			tile = mode;
+			break;
+		}
+	if (!tile)
+		return;
+	list_for_each_entry(mode, &connector->probed_modes, head)
+		if (mode == tile)
+			mode->type |= DRM_MODE_TYPE_PREFERRED;
+		else
+			mode->type &= ~DRM_MODE_TYPE_PREFERRED;
+}
