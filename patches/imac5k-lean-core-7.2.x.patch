+/*
+ * Wire the two tiles of an Apple 5K panel to each other (link->tiled_peer):
+ * the eDP root to its first DP sibling, the DP slave to the eDP root. The
+ * slave's pre-sink paths reach the root's quirk through this.
+ */
+static void dm_helpers_wire_tiled_peer(struct dc_link *link,
+				       const struct dc_panel_patch *pp)
+{
+	bool is_root = pp->apple_tiled_root &&
+		       link->connector_signal == SIGNAL_TYPE_EDP;
+	bool is_slave = pp->apple_tiled_slave &&
+			link->connector_signal == SIGNAL_TYPE_DISPLAY_PORT;
+	uint32_t i;
+
+	if (!link->dc || link->tiled_peer || (!is_root && !is_slave))
+		return;
+
+	for (i = 0; i < link->dc->link_count; i++) {
+		struct dc_link *other = link->dc->links[i];
+
+		if (!other || other == link || other->tiled_peer)
+			continue;
+		if ((is_root && other->connector_signal == SIGNAL_TYPE_DISPLAY_PORT) ||
+		    (is_slave && dc_link_is_apple_tiled_root(other))) {
+			link->tiled_peer = other;
+			other->tiled_peer = link;
+			return;
+		}
+	}
+}
