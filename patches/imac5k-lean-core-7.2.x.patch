+	mutex_lock(&adev->dm.dc_lock);
+	dc_exit_ips_for_hw_access(adev->dm.dc);
+	dm_helpers_read_local_edid(root->dc_link->ctx, root->dc_link, sink);
+	mutex_unlock(&adev->dm.dc_lock);
