+/* True when a link on this device is wired as an Apple 5K tile pair. */
+bool amdgpu_dm_has_apple_tiled_panel(struct amdgpu_device *adev)
+{
+	struct dc *dc = adev ? adev->dm.dc : NULL;
+	int i;
+
+	if (!dc)
+		return false;
+	for (i = 0; i < dc->link_count; i++)
+		if (dc->links[i] && dc->links[i]->tiled_peer)
+			return true;
+	return false;
+}
+
+/*
+ * Going down for the firmware: from here on the tile wake paths are no-ops,
+ * so the latch clear done on stream disable is not undone by the HPD-RX
+ * re-detect the panel raises in response. See dc.apple_5k_going_down.
+ */
+void amdgpu_dm_apple5k_going_down(struct amdgpu_device *adev)
+{
+	if (adev && adev->dm.dc)
+		adev->dm.dc->apple_5k_going_down = true;
+}
+
+/*
+ * After the display has been shut down, power the root eDP panel off and hold
+ * it for a full T12, so the firmware finds the panel as a cold boot does.
+ */
+void amdgpu_dm_apple5k_panel_power_off(struct amdgpu_device *adev)
+{
+	struct dc *dc = adev ? adev->dm.dc : NULL;
+	int i;
+
+	if (!dc || !dc->hwss.edp_power_control)
+		return;
+
+	for (i = 0; i < dc->link_count; i++) {
+		if (!dc_link_has_tiled_root_panel_patch(dc->links[i]))
+			continue;
+		dc->hwss.edp_power_control(dc->links[i], false);
+		msleep(600);
+	}
+}
