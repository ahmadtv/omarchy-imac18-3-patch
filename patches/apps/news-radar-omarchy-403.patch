+  // Omarchy 4.0.3 strips __sourceDir from third-party manifests before handing
+  // them to a plugin (shell.qml publicPluginManifest), which leaves every
+  // helper path empty and makes each Process command start with "". Fall back
+  // to the plugin's own install directory so the CLI stays reachable.
+  readonly property string sourceDir: manifest && manifest.__sourceDir
+    ? String(manifest.__sourceDir)
+    : (Quickshell.env("XDG_CONFIG_HOME") || (Quickshell.env("HOME") + "/.config"))
+      + "/omarchy/plugins/" + pluginId
+  readonly property string helperPath: sourceDir + "/bin/news-radar-client"
+  readonly property string shortcutHelperPath: sourceDir + "/bin/news-radar-shortcut"
+  readonly property string brandLogoPath: sourceDir + "/assets/omarchy-logo.svg"
   readonly property string cacheBase: Quickshell.env("XDG_CACHE_HOME")
     || (Quickshell.env("HOME") + "/.cache")
   readonly property string pluginId: manifest && manifest.id
