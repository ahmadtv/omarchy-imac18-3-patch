#!/usr/bin/env bash
#
# imac-patcher — patch manager for the Apple iMac18,3 under Linux/Omarchy.
#
# Every fix is a module implementing the same contract:
#   mod_<id>_title / _tier / _desc   metadata
#   mod_<id>_detect                  -> applied | not-applied | partial | n/a
#   mod_<id>_apply                   install it
#   mod_<id>_remove                  undo it
#
# Tiers:
#   safe   fully reversible, no boot risk       (pre-selected)
#   boot   touches boot config or GPU driver    (flagged, prints recovery first)
#
# Usage:
#   imac-patcher                 interactive
#   imac-patcher --status        print status of every module
#   imac-patcher --apply  <id..> apply named modules (or "safe" for all safe ones)
#   imac-patcher --remove <id..> remove named modules
#
set -uo pipefail

# Resolve through symlinks: the menu calls this as ~/.local/bin/imac-patcher,
# and every patch file we ship is found relative to the real script.
SCRIPT_DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
REPO_DIR="$(dirname "$SCRIPT_DIR")"
INSTALLER_5K="${SCRIPT_DIR}/patch-imac5k-amdgpu.sh"
LOGDIR="${HOME}/.local/state/imac-patcher"
CACHE="${HOME}/.cache/imac-patcher"
KREL="$(uname -r)"
KSERIES="$(uname -r | cut -d. -f1-2)"
# The newest installed kernel. It differs from the running one after a distro
# kernel upgrade, before the reboot -- and that gap is exactly when the patched
# modules have to be built, so they are already in place on its first boot
# instead of the machine coming up with a broken display and no sound.
newest_kernel() { local d; for d in /usr/lib/modules/*/kernel; do d="${d%/kernel}"; basename "$d"; done | sort -V | tail -1; }
TARGET_KREL="$(newest_kernel)"; TARGET_KREL="${TARGET_KREL:-$KREL}"
TARGET_KSERIES="$(cut -d. -f1-2 <<<"$TARGET_KREL")"
kernel_pending() { [[ "$TARGET_KREL" != "$KREL" ]]; }
SUPPORTED_5K_SERIES="7.1 7.2"
LIMINE_DEFAULT=/etc/default/limine
VIDEO_4K='video=eDP-1:3840x2160@60e'
MONITORS_LUA="${HOME}/.config/hypr/monitors.lua"
EQ_DEST="${HOME}/.config/pipewire/filter-chain.conf.d/eq6.conf"
SLEEP_TARGETS=(suspend.target hibernate.target hybrid-sleep.target suspend-then-hibernate.target)
mkdir -p "$LOGDIR" "$CACHE"

# Hardware patches first, then tweaks -- patches to other people's apps, which
# are opt-in, never included in "safe", and go away by themselves when the app
# moves on. Tweaks usually come from your own repo; see "modules from elsewhere".
MODULES=(audio eq color vram wifi suspend boot 5k panel)

HAVE_GUM=0; command -v gum >/dev/null && HAVE_GUM=1
say()  { printf '\033[1;33m==>\033[0m %s\n' "$*"; }
warn() { printf '\033[1;31m!!\033[0m %s\n' "$*"; }
hdr()  { if ((HAVE_GUM)); then gum style --border rounded --padding "0 2" --bold "$*"; else printf '\n== %s ==\n' "$*"; fi; }
confirm(){ if ((HAVE_GUM)); then gum confirm "$1"; else read -rp "$1 [y/N] " a; [[ $a == [yY]* ]]; fi; }

# ── hardware gate ──────────────────────────────────────────────────────────
product="$(cat /sys/class/dmi/id/product_name 2>/dev/null || echo unknown)"
if [[ "$product" != "iMac18,3" && " $* " != *" --force "* ]]; then
    echo "This tool targets the iMac18,3 (detected: ${product}). Refusing. Use --force to override." >&2
    exit 1
fi

# ── tweaks: patches to other people's apps ─────────────────────────────────
# A patch to an Omarchy plugin or a third-party one, tier "tweak". Three rules
# keep these from becoming a mess:
#
#   * The target must be a git checkout. That is what makes removal exact and
#     traceless -- reverse-applying our own diff and then finding the checkout
#     identical to upstream is a proof, not a hope -- and it is what lets us
#     tell that the app has moved on.
#   * Detection asks the checkout, never a stamp file we wrote. If an update
#     replaced the file, or the plugin was reinstalled, the patch reads as off
#     by itself, which is exactly what should happen.
#   * Apply refuses unless the diff applies cleanly to the checkout as it is
#     now, so a patch is never half-applied to a version it was not written for.
#
# `omarchy plugin update` fast-forwards and aborts on modified tracked files,
# so patched plugins would block their own update. --update-apps handles that:
# it removes these patches, updates, and puts back the ones that still apply.
APPS_DIR="${REPO_DIR}/patches/apps"
app_dir() { echo "${HOME}/.config/omarchy/plugins/$1"; }
app_patch_detect() {   # <plugin-id> <patch-file>
    local d; d="$(app_dir "$1")"
    [[ -d $d/.git && -f $2 ]] || { echo n/a; return; }          # not installed
    if   git -C "$d" apply --reverse --check "$2" &>/dev/null; then echo applied
    elif git -C "$d" apply           --check "$2" &>/dev/null; then echo not-applied
    else echo n/a; fi                                            # app has moved on
}
app_patch_apply() {    # <plugin-id> <patch-file>
    local d; d="$(app_dir "$1")"
    [[ -d $d/.git ]] || { warn "$1 is not installed as a git checkout"; return 1; }
    git -C "$d" apply --reverse --check "$2" &>/dev/null && { say "already applied"; return 0; }
    git -C "$d" apply --check "$2" 2>/dev/null || {
        warn "the patch does not apply to $1 as it stands ($(git -C "$d" rev-parse --short HEAD))."
        warn "The app has moved on — the patch needs re-porting, or upstream already carries it."
        return 1; }
    git -C "$d" apply "$2" || return 1
    say "patched $1"
}
app_patch_remove() {   # <plugin-id> <patch-file>
    local d; d="$(app_dir "$1")"
    [[ -d $d/.git ]] || return 0
    git -C "$d" apply --reverse --check "$2" &>/dev/null && { git -C "$d" apply --reverse "$2" || return 1; }
    if [[ -z "$(git -C "$d" status --porcelain)" ]]; then
        say "$1 is byte-for-byte upstream again — no trace left"
    else
        warn "$1 still differs from upstream: $(git -C "$d" status --short | tr '\n' ' ')"
    fi
}
restart_shell() { pkill -x quickshell 2>/dev/null || true; say "shell restarted"; }

# ═══════════════════════ module: audio ═════════════════════════════════════
AUDIO_REPO=https://github.com/jackdanyell/imac18-3-cs8409-linux-audio
AUDIO_SRC="${CACHE}/imac18-3-cs8409-linux-audio"
# jackdanyell commit our patch is verified against. Same model as the 5K side:
# pristine upstream + our diff, so we track upstream without maintaining a fork.
# When jackdanyell moves and the patch stops applying, re-verify and re-pin here.
AUDIO_PIN=be90113
AUDIO_PATCH="${REPO_DIR}/patches/cs8409-headset-capture.patch"
AUDIO_DKMS=snd_hda_macbookpro
# Any other DKMS package that builds a module named snd-hda-codec-cs8409 drops
# it in the same updates/dkms directory as ours, so on the next kernel update
# the order `dkms autoinstall` happens to run in decides which one survives.
# That is a coin flip between working audio and silence, so find and clear it.
audio_rival_dkms() {
    local d name ver
    for d in /usr/src/*/dkms.conf; do
        [[ -f $d ]] || continue
        grep -qi 'BUILT_MODULE_NAME.*cs8409' "$d" || continue
        name="$(sed -n 's/^PACKAGE_NAME="\?\([^"]*\)"\?.*/\1/p' "$d" | head -1)"
        [[ -z $name || $name == "$AUDIO_DKMS" ]] && continue
        ver="$(sed -n 's/^PACKAGE_VERSION="\?\([^"]*\)"\?.*/\1/p' "$d" | head -1)"
        printf '%s/%s\n' "$name" "$ver"
    done
}
# `dkms status ... installed` only says DKMS registered a build. With a rival
# module of the same name, the file actually sitting in updates/dkms may be the
# other one -- so check for the parameter only our patch adds.
audio_installed_is_ours() {   # audio_installed_is_ours <kernelrelease>
    local ko
    ko="$(find "/usr/lib/modules/$1/updates" -name 'snd-hda-codec-cs8409.ko*' 2>/dev/null | head -1)"
    [[ -n $ko ]] && modinfo "$ko" 2>/dev/null | grep -q headset_buttons
}
mod_audio_title() { echo "Speakers & microphone (CS8409)"; }
mod_audio_tier()  { echo safe; }
mod_audio_desc()  { echo "The in-kernel driver finds no speaker output on this board. Installs the DKMS driver (survives kernel updates) with the headset-capture patch: internal + headset mic, automatic in/out switching on plug/unplug, and the inline remote buttons."; }
mod_audio_detect() {
    # NB: capture then match. "cmd | grep -q" is unsafe under `set -o pipefail`:
    # grep -q exits on first match, the producer takes SIGPIPE, and pipefail
    # then reports the pipeline as failed despite the match succeeding.
    local dkms_ok=0 loaded=0 patched=0 dkms_out mods
    dkms_out="$(dkms status 2>/dev/null)"
    mods="$(lsmod 2>/dev/null)"
    # DKMS registration is what rebuilds the driver on the NEXT kernel update,
    # so the kernel that matters is the one we will boot. A kernel upgrade drops
    # the superseded kernel's registration while leaving its module file in
    # place, so checking the running kernel here reports a false failure.
    [[ $dkms_out == *"${AUDIO_DKMS}"*"${TARGET_KREL}"*"installed"* ]] && dkms_ok=1
    [[ $'\n'$mods == *$'\n'snd_hda_codec_cs8409* ]] && loaded=1
    audio_installed_is_ours "$KREL" && patched=1
    if kernel_pending && ! audio_installed_is_ours "$TARGET_KREL"; then echo partial
    elif (( dkms_ok && loaded && patched )); then echo applied
    elif (( loaded )); then echo partial       # driver up, but unpatched and/or DKMS can't rebuild it
    else echo not-applied; fi
}
mod_audio_preflight() {
    # The driver is a DKMS-built kernel module, and the upstream installer also
    # downloads a kernel source tarball to build the HDA tree — so it needs the
    # same headers + build tools as the 5K module, plus dkms/patch/git/wget/tar.
    # Without kernel headers the DKMS build fails deep in a compile and the only
    # visible symptom is "partial / no sound" — check up front instead.
    local ok=1 missing=() pkgs=() t
    for t in dkms patch git gcc make wget tar; do
        command -v "$t" >/dev/null || missing+=("$t")
    done
    if (( ${#missing[@]} )); then
        warn "missing tools: ${missing[*]}"
        for t in "${missing[@]}"; do case $t in
            gcc|make) pkgs+=(base-devel) ;;
            *)        pkgs+=("$t") ;;
        esac; done
        mapfile -t pkgs < <(printf '%s\n' "${pkgs[@]}" | sort -u)
        say "install with:  sudo pacman -S --needed ${pkgs[*]}"
        if confirm "Install them now?"; then
            sudo pacman -S --needed --noconfirm "${pkgs[@]}" || ok=0
        else ok=0; fi
    else
        say "build tools present"
    fi
    local rival r
    rival="$(audio_rival_dkms)"
    if [[ -n $rival ]]; then
        warn "another DKMS module builds snd-hda-codec-cs8409 and would fight ours for the"
        warn "same path on the next kernel update: $(tr '\n' ' ' <<<"$rival")"
        if confirm "Remove it? (ours replaces it)"; then
            while read -r r; do
                [[ -n $r ]] || continue
                # This deletes the .ko at the shared path -- which is OURS
                # whenever we installed last. DKMS has no idea another package
                # overwrote its file, so it takes ours down with it and puts the
                # stock module back. Whatever we remove here, ours is rebuilt
                # below; never treat this as a removal of the rival alone.
                sudo dkms remove "$r" --all 2>/dev/null || true
                # Leaving the source tree means the next kernel update rebuilds
                # it and it wins the path again, so the tree has to go too.
                [[ -f "/usr/src/${r/\//-}/dkms.conf" ]] && sudo rm -rf "/usr/src/${r/\//-}"
            done <<<"$rival"
            local k
            for k in "$KREL" "$TARGET_KREL"; do
                audio_installed_is_ours "$k" && continue
                [[ -d "/usr/lib/modules/$k/kernel" ]] || continue
                say "reinstalling our driver for ${k} (the removal took it too)"
                sudo dkms install "${AUDIO_DKMS}/0.2" -k "$k" --force 2>&1 | tail -3
            done
        else
            warn "left in place — a future kernel update may silently replace our driver with it"
        fi
    fi
    if [[ -e "/usr/lib/modules/${TARGET_KREL}/build/Module.symvers" ]]; then
        say "kernel headers present"
    else
        warn "linux-headers missing for ${TARGET_KREL} — the DKMS build would fail without them"
        if confirm "Install linux-headers now?"; then
            sudo pacman -S --needed --noconfirm linux-headers || ok=0
        else ok=0; fi
    fi
    return $(( 1 - ok ))
}
mod_audio_apply() {
    mod_audio_preflight || { warn "preflight failed — nothing was changed."; return 1; }
    [[ -f "$AUDIO_PATCH" ]] || { warn "audio patch missing: $AUDIO_PATCH"; return 1; }
    # A prior install may be registered but broken (source dir vanished, e.g. it
    # lived in /tmp). Clear that first so the installer can re-register cleanly.
    if dkms status 2>/dev/null | grep -q "snd_hda_macbookpro.*broken"; then
        say "removing broken DKMS registration"
        sudo dkms remove snd_hda_macbookpro/0.2 --all 2>/dev/null || true
    fi
    # Upstream driver source at the exact commit the patch is verified against.
    if [[ -d "$AUDIO_SRC/.git" ]]; then
        say "refreshing driver source"
        git -C "$AUDIO_SRC" fetch --quiet origin 2>&1 | tail -2 || { warn "git fetch failed"; return 1; }
    else
        say "cloning driver source into $AUDIO_SRC"
        git clone --quiet "$AUDIO_REPO" "$AUDIO_SRC" 2>&1 | tail -2 || return 1
    fi
    say "checking out pinned upstream commit $AUDIO_PIN"
    git -C "$AUDIO_SRC" checkout -f --quiet "$AUDIO_PIN" 2>/dev/null \
        || { warn "upstream commit $AUDIO_PIN not found — jackdanyell history changed; re-pin AUDIO_PIN in this script"; return 1; }
    git -C "$AUDIO_SRC" clean -fdq
    # Apply our patch on top. Fail loudly if it no longer applies rather than
    # building a half-patched driver — same discipline as the 5K version gate.
    say "applying $(basename "$AUDIO_PATCH")"
    if ! patch -d "$AUDIO_SRC" -p1 --dry-run --force < "$AUDIO_PATCH" >/dev/null 2>&1; then
        warn "the audio patch does not apply to $AUDIO_PIN — it needs re-porting (see patches/)"
        return 1
    fi
    patch -d "$AUDIO_SRC" -p1 --force < "$AUDIO_PATCH" >/dev/null || return 1
    ( cd "$AUDIO_SRC" && sudo ./install-imac18-3.sh ) || { warn "the DKMS build failed — see the output above (most often missing linux-headers for ${KREL})"; return 1; }
    # Verify DKMS actually registered for this kernel, so we never report success
    # while the stock in-kernel cs8409 (which drives no speakers) is all that's
    # loaded — the exact "partial / no sound" state this is meant to prevent.
    # The upstream installer builds for the running kernel. After an upgrade the
    # new kernel is installed but not running, so build for it as well -- audio
    # then works on its first boot instead of the one after.
    if kernel_pending; then
        say "also building for the pending kernel ${TARGET_KREL}"
        sudo dkms install "${AUDIO_DKMS}/0.2" -k "$TARGET_KREL" 2>&1 | tail -3 \
            || warn "build for ${TARGET_KREL} failed — audio will be silent on its first boot"
    fi
    local k bad=0 kernels=("$KREL")
    kernel_pending && kernels+=("$TARGET_KREL")
    for k in "${kernels[@]}"; do
        if audio_installed_is_ours "$k"; then say "patched driver installed for ${k}"
        else warn "the installed cs8409 module for ${k} is not our patched build"; bad=1; fi
    done
    (( bad )) && { warn "audio will not work fully until this succeeds (check: dkms status)"; return 1; }
    say "installed — reboot to load the new module"
}
mod_audio_remove() {
    [[ -x "$AUDIO_SRC/install.cirrus.driver.sh" ]] && ( cd "$AUDIO_SRC" && sudo ./install.cirrus.driver.sh -r )
    sudo dkms remove snd_hda_macbookpro/0.2 --all 2>/dev/null || true
    say "stock module restored — reboot to load it"
}

# ═══════════════════════ module: eq ════════════════════════════════════════
# Installed as a native Omarchy speaker tuning rather than a loose filter-chain.
# That naming is not cosmetic: the shell hides the physical sink while a sink
# called omarchy_speaker_tuning fronts it, and excludes the tuning's own output
# from the application list -- so the stock path shows ONE output named for the
# speakers, where a hand-rolled chain shows the tuning and the hardware twice.
# It also makes the volume keys resolve through the filter to the real sink.
OMARCHY_TUNINGS="${OMARCHY_PATH:-/usr/share/omarchy}/default/audio/tunings"
EQ_TUNING_SRC="${REPO_DIR}/audio/tunings/imac18-3"
EQ_TUNING_DEST="${OMARCHY_TUNINGS}/imac18-3"
EQ_TUNING_KEEP="/usr/local/share/omarchy-imac5k/tunings/imac18-3"
EQ_TUNING_HOOK="/etc/pacman.d/hooks/imac-speaker-tuning.hook"
WP_NAMES_SRC="${REPO_DIR}/audio/wireplumber/51-imac-audio-names.conf"
WP_NAMES="${HOME}/.config/wireplumber/wireplumber.conf.d/51-imac-audio-names.conf"
mod_eq_title() { echo "Speaker tone EQ"; }
mod_eq_tier()  { echo safe; }
mod_eq_desc()  { echo "The codec does no DSP at all; macOS's warmth is entirely software EQ. Installs an Omarchy speaker tuning (bass shelf + lookahead limiter) and keeps it off the headphone jack."; }
mod_eq_detect() {
    local tuning=0 host=0
    [[ -f "${EQ_TUNING_DEST}/tuning.conf" ]] && tuning=1
    systemctl --user is-active omarchy-speaker-tuning.service &>/dev/null && host=1
    if (( tuning && host )); then echo applied
    elif (( tuning || host )); then echo partial
    else echo not-applied; fi
}
mod_eq_apply() {
    # Every Omarchy tuning ends in a lookahead limiter, which is an LV2 plugin;
    # omarchy-audio-tuning refuses to install without it.
    if [[ ! -e /usr/lib/lv2/lsp-plugins.lv2/limiter_stereo.ttl ]]; then
        say "installing the LV2 limiter the tuning needs"
        sudo pacman -S --needed --noconfirm lsp-plugins-lv2 || return 1
    fi
    [[ -f "${EQ_TUNING_SRC}/tuning.conf" ]] || { warn "tuning missing: ${EQ_TUNING_SRC}"; return 1; }
    say "installing the iMac18,3 tuning into ${EQ_TUNING_DEST}"
    sudo install -d -m755 "$EQ_TUNING_DEST" || return 1
    sudo install -m644 "${EQ_TUNING_SRC}/tuning.conf" "${EQ_TUNING_SRC}/filter-chain.conf" "$EQ_TUNING_DEST" || return 1
    # omarchy-settings owns that directory and an update replaces it, which
    # silently switches the EQ off. Keep a copy outside it and let pacman put
    # the tuning back after every omarchy-settings upgrade.
    sudo install -d -m755 "$EQ_TUNING_KEEP" || return 1
    sudo install -m644 "${EQ_TUNING_SRC}/tuning.conf" "${EQ_TUNING_SRC}/filter-chain.conf" "$EQ_TUNING_KEEP" || return 1
    sudo install -Dm644 "${REPO_DIR}/audio/pacman/imac-speaker-tuning.hook" "$EQ_TUNING_HOOK" || return 1

    # An earlier revision of this patch shipped the same curve as a loose
    # filter-chain fragment. Left in place it would run a second copy of the EQ
    # in series with the tuning.
    if [[ -f "$EQ_DEST" ]]; then
        say "removing the superseded standalone EQ fragment"
        rm -f "$EQ_DEST"
        systemctl --user disable --now filter-chain.service &>/dev/null
    fi

    omarchy-audio-tuning on || { warn "omarchy-audio-tuning refused — see the message above"; return 1; }

    # The codec publishes itself as its part number, "CS8409/CS42L83 Analog".
    say "installing readable device names"
    install -Dm644 "$WP_NAMES_SRC" "$WP_NAMES" || return 1
    systemctl --user restart wireplumber || true

    if omarchy-audio-tuning fronted-sink >/dev/null 2>&1; then
        say "one output, named iMac Audio — the bare codec is hidden behind it"
    else
        warn "the tuning sink is not fronting the hardware; the output list will still show both"
    fi
}
mod_eq_remove() {
    rm -f "$WP_NAMES"
    omarchy-audio-tuning off || true
    [[ -d "$EQ_TUNING_DEST" ]] && sudo rm -rf "$EQ_TUNING_DEST"
    sudo rm -rf "$EQ_TUNING_KEEP" "$EQ_TUNING_HOOK"
    say "tuning removed — output goes straight to the codec again"
}

# ═══════════════════════ module: panel ═════════════════════════════════════
# The volume panel names devices, and speakers + headphone jack are ONE device
# with two ports, so its label and icon never followed the jack. Proposed to
# Omarchy as a change to the audio panel; until it lands, Omarchy's own plugin
# clone mechanism carries it: the built-in panel is cloned into ~/.config and
# the same diff applied there. Remove this module once the upstream panel has
# it (the clone would otherwise shadow later upstream improvements).
PANEL_PATCH="${REPO_DIR}/patches/omarchy-audio-ports.patch"
PANEL_HELPERS=(omarchy-audio-ports omarchy-audio-set-port)   # shipped in scripts/, installed to ~/.local/bin
panel_clone_manifest() { grep -l '"clonedFrom": *"omarchy.audio"' "${HOME}"/.config/omarchy/plugins/*/manifest.json 2>/dev/null | head -1; }
mod_panel_title() { echo "Speakers / Headphones rows in the volume panel"; }
# Not "app" despite patching an Omarchy plugin: this exists because of THIS
# machine's combo jack, it is what makes the volume panel tell the truth here,
# and a vanilla 18,3 should get it without asking. The app tier is for patches
# you keep to yourself. (Upstream: basecamp/omarchy#10985 — when that lands,
# this module removes the clone and the tier stops mattering.)
mod_panel_tier()  { echo safe; }
mod_panel_desc()  { echo "Speakers or Headphones (and Internal or Headset Microphone) as rows, the live one highlighted, the bar icon following the jack, the way macOS lists them. On this codec the driver routes on the jack itself, so the rows follow it rather than offering an override. Carried as a clone of Omarchy's audio panel until the upstream change lands."; }
mod_panel_detect() {
    local m; m="$(panel_clone_manifest)"
    local clone=0 patched=0 helper=0
    [[ -n $m ]] && clone=1
    [[ -n $m ]] && grep -q 'omarchy-audio-ports' "$(dirname "$m")/Panel.qml" 2>/dev/null && patched=1
    helper=1; local h; for h in "${PANEL_HELPERS[@]}"; do [[ -x "${HOME}/.local/bin/$h" ]] || helper=0; done
    if (( clone && patched && helper )); then echo applied
    elif (( clone || helper )); then echo partial
    else echo not-applied; fi
}
mod_panel_apply() {
    local m d id
    command -v omarchy-plugin-clone >/dev/null || { warn "omarchy-plugin-clone not found — this Omarchy is too old for plugin clones"; return 1; }
    m="$(panel_clone_manifest)"
    if [[ -z $m ]]; then
        say "cloning the built-in audio panel into your config"
        omarchy-plugin-clone omarchy.audio </dev/null || return 1
        m="$(panel_clone_manifest)"; [[ -n $m ]] || { warn "clone did not appear"; return 1; }
    fi
    d="$(dirname "$m")"; id="$(jq -r .id "$m")"
    if grep -q 'omarchy-audio-ports' "$d/Panel.qml"; then
        say "panel already carries the change"
    else
        # The diff is against Omarchy's tree; the clone holds the same files flat.
        if ! patch -d "$d" -p4 --dry-run --force < "$PANEL_PATCH" >/dev/null 2>&1; then
            warn "the panel change no longer applies to this Omarchy version — likely upstream already has it, or the panel moved. Nothing changed."
            omarchy-plugin-remove "$id" </dev/null >/dev/null 2>&1 || true
            return 1
        fi
        patch -d "$d" -p4 --force < "$PANEL_PATCH" >/dev/null || return 1
        # the clone tool rewrites the plugin id inside its files; keep that true
        sed -i "s|omarchy\.audio|${id}|g" "$d/Panel.qml" "$d/Model.js"
    fi
    local h; for h in "${PANEL_HELPERS[@]}"; do install -Dm755 "${SCRIPT_DIR}/$h" "${HOME}/.local/bin/$h" || return 1; done
    rm -f "${HOME}/.local/bin/omarchy-audio-port-labels"   # earlier revision of this module
    say "restarting the shell"
    pkill -x quickshell || true
    say "plug headphones in: the row reads Headphones and the bar icon follows"
}
mod_panel_remove() {
    local m id; m="$(panel_clone_manifest)"
    if [[ -n $m ]]; then id="$(jq -r .id "$m")"; omarchy-plugin-remove "$id" </dev/null || true; fi
    local h; for h in "${PANEL_HELPERS[@]}"; do rm -f "${HOME}/.local/bin/$h"; done
    pkill -x quickshell || true
    say "back on Omarchy's built-in audio panel"
}

# ═══════════════════════ module: color ═════════════════════════════════════
mod_color_title() { echo "Wide-gamut colour"; }
mod_color_tier()  { echo safe; }
mod_color_desc()  { echo "The panel is Display P3 and 10-bit; Hyprland's default sRGB mode leaves everything oversaturated. Sets cm=\"dp3\" on the monitor."; }
mod_color_detect() {
    [[ -f "$MONITORS_LUA" ]] || { echo n/a; return; }
    grep -q 'cm = "dp3"' "$MONITORS_LUA" && echo applied || echo not-applied
}
mod_color_apply() {
    [[ -f "$MONITORS_LUA" ]] || { warn "$MONITORS_LUA not found"; return 1; }
    cp "$MONITORS_LUA" "${MONITORS_LUA}.bak-$(date +%s)"
    if grep -q 'cm = "' "$MONITORS_LUA"; then
        sed -i 's/cm = "[a-z0-9]*"/cm = "dp3"/' "$MONITORS_LUA"
    else
        # add cm to the active (uncommented) hl.monitor line
        sed -i '/^hl\.monitor({/ s/ })$/, cm = "dp3" })/' "$MONITORS_LUA"
    fi
    grep -q 'cm = "dp3"' "$MONITORS_LUA" || { warn "could not edit $MONITORS_LUA — do it by hand"; return 1; }
    # a 10-bit panel; declared for what it is, not as a fix (see TODO on genlock)
    if grep -q 'bitdepth = ' "$MONITORS_LUA"; then sed -i 's/bitdepth = [0-9]*/bitdepth = 10/' "$MONITORS_LUA"
    else sed -i '/^hl\.monitor({/ s/ })$/, bitdepth = 10 })/' "$MONITORS_LUA"; fi
    command -v hyprctl >/dev/null && hyprctl reload >/dev/null 2>&1
    say "applied: $(grep -o 'colorManagementPreset: .*' <(hyprctl monitors all 2>/dev/null) | head -1)"
}
mod_color_remove() {
    [[ -f "$MONITORS_LUA" ]] || return 0
    cp "$MONITORS_LUA" "${MONITORS_LUA}.bak-$(date +%s)"
    sed -i 's/, cm = "dp3"//; s/cm = "dp3"/cm = "auto"/' "$MONITORS_LUA"
    command -v hyprctl >/dev/null && hyprctl reload >/dev/null 2>&1
}

# ═══════════════════════ module: vram ══════════════════════════════════════
# The GPU has a 256 MiB CPU-visible VRAM window. ggml's Vulkan backend (voxtype,
# local LLM tools) fills it by default; the shutdown splash then cannot pin its
# framebuffer and the machine freezes at the logo on reboot. ggml's own switch
# for small-BAR GPUs, set once for the whole user session.
VRAM_ENV_SRC="${REPO_DIR}/configs/environment.d/50-imac-small-bar.conf"
VRAM_ENV="${HOME}/.config/environment.d/50-imac-small-bar.conf"
vram_restart_users() {
    # tools already running keep their old environment; restart the ones we know
    local u; for u in voxtype.service; do
        systemctl --user is-active "$u" &>/dev/null && systemctl --user restart "$u" && say "restarted $u"
    done; return 0
}
mod_vram_title() { echo "GPU compute tools off the small VRAM window"; }
mod_vram_tier()  { echo safe; }
mod_vram_desc()  { echo "voxtype and other ggml/Vulkan tools fill the GPU's 256 MiB CPU-visible slice, and the shutdown splash then cannot draw: the machine freezes at the logo on reboot. Sets ggml's small-BAR switch for the session."; }
mod_vram_detect() {
    [[ -f "$VRAM_ENV" ]] && grep -q 'GGML_VK_DISABLE_HOST_VISIBLE_VIDMEM=1' "$VRAM_ENV" && echo applied || echo not-applied
}
mod_vram_apply() {
    install -Dm644 "$VRAM_ENV_SRC" "$VRAM_ENV" || return 1
    systemctl --user daemon-reload   # re-runs the environment generators
    vram_restart_users
    say "set for the session; anything started from now on has it"
}
mod_vram_remove() {
    rm -f "$VRAM_ENV"; systemctl --user daemon-reload; vram_restart_users
    say "removed — ggml tools may use the CPU-visible window again"
}

# ═══════════════════════ module: wifi ══════════════════════════════════════
WIFI_CONF_SRC="${REPO_DIR}/configs/modprobe.d/brcmfmac.conf"
WIFI_CONF="/etc/modprobe.d/brcmfmac.conf"
mod_wifi_title() { echo "Wi-Fi association (BCM43602)"; }
mod_wifi_tier()  { echo safe; }
mod_wifi_desc()  { echo "The Broadcom firmware's own WPA handshake fails to associate on common WPA2/WPA3-mixed networks. Hands the handshake to the host supplicant (disables firmware FWSUP and SAE). WPA3-only networks are not available with this on."; }
mod_wifi_detect() {
    grep -qs 'feature_disable=0x82000' "$WIFI_CONF" && echo applied || echo not-applied
}
mod_wifi_apply() {
    sudo install -Dm644 "$WIFI_CONF_SRC" "$WIFI_CONF" || return 1
    say "takes effect when the Wi-Fi driver next loads — reboot, or: sudo modprobe -r brcmfmac && sudo modprobe brcmfmac"
}
mod_wifi_remove() {
    sudo rm -f "$WIFI_CONF"; say "removed — firmware handshake again after the next driver load"
}

# ═══════════════════════ module: suspend ═══════════════════════════════════
mod_suspend_title() { echo "Block suspend/hibernate"; }
mod_suspend_tier()  { echo safe; }
mod_suspend_desc()  { echo "Sleep hard-hangs this machine every time (Apple firmware ACPI issue; recovery is a hard power-cycle). Masks the sleep targets so nothing triggers them by accident."; }
mod_suspend_detect() {
    local masked=0
    for t in "${SLEEP_TARGETS[@]}"; do
        [[ "$(systemctl is-enabled "$t" 2>/dev/null)" == masked ]] && (( masked++ ))
    done
    if (( masked == ${#SLEEP_TARGETS[@]} )); then echo applied
    elif (( masked > 0 )); then echo partial
    else echo not-applied; fi
}
mod_suspend_apply()  { sudo systemctl mask "${SLEEP_TARGETS[@]}"; }
mod_suspend_remove() { sudo systemctl unmask "${SLEEP_TARGETS[@]}"; warn "sleep re-enabled — it is known to hang this machine"; }

# ═══════════════════════ module: boot ══════════════════════════════════════
HYGIENE_HOOK=/etc/boot/hooks/post.d/95-limine-esp-hygiene
LIMINE_PKG_EFI=/usr/share/limine/BOOTX64.EFI

mod_boot_title() { echo "Boot config hygiene"; }
mod_boot_tier()  { echo boot; }
mod_boot_desc()  { echo "Repairs two ways the boot menu goes wrong on this machine: stray limine.conf copies that silently override the real one (so new snapshots never appear), and a UKI copied over the EFI fallback (so that boot route shows no menu at all). Installs a hook that keeps it that way."; }

# Everything here lives under /boot, which is root-only, so probe in one
# non-interactive sudo and fall back to n/a rather than prompting from a
# status listing.
mod_boot_detect() {
    sudo -n true 2>/dev/null || { echo n/a; return; }
    local shadows fallback_uki hook
    shadows="$(sudo -n bash -c 'n=0; for f in /boot/EFI/limine/limine.conf /boot/EFI/BOOT/limine.conf /boot/boot/limine/limine.conf /boot/limine/limine.conf; do [[ -f $f ]] && n=$((n+1)); done; echo $n')"
    fallback_uki="$(sudo -n bash -c 'f=/boot/EFI/BOOT/BOOTX64.EFI
        [[ -f $f ]] || { echo no; exit; }
        p=$(mktemp); trap "rm -f $p" EXIT
        objcopy -O binary --only-section=.cmdline "$f" "$p" 2>/dev/null
        [[ -s $p ]] && echo yes || echo no')"
    hook=no; [[ -x $HYGIENE_HOOK ]] && hook=yes

    if [[ $shadows == 0 && $fallback_uki == no && $hook == yes ]]; then echo applied
    elif [[ $shadows == 0 && $fallback_uki == no ]]; then echo partial
    else echo not-applied; fi
}

mod_boot_apply() {
    cat <<'EOF'

What this changes, and how to undo it:
  * deletes stray limine.conf copies under /boot/EFI (the real one at
    /boot/limine.conf is untouched; copies are archived first)
  * if the EFI fallback is a UKI, restores the Limine binary there
    (the UKI is kept as BOOTX64.UKI-bypass.backup)
  * installs a post.d hook so both stay correct after kernel updates

Recovery: boot the OpenCore route or a Snapshot entry; restore with
  sudo cp /boot/EFI/BOOT/BOOTX64.UKI-bypass.backup /boot/EFI/BOOT/BOOTX64.EFI
EOF
    confirm "Repair the boot configuration?" || return 1

    sudo mkdir -p /boot/limine-conf-shadow-backup
    local f
    for f in "${LIMINE_SHADOW_CONFIGS[@]}"; do
        sudo test -f "$f" || continue
        sudo cp -f "$f" "/boot/limine-conf-shadow-backup/$(printf '%s' "${f#/boot/}" | tr / _)"
        sudo rm -f "$f" && say "removed shadowing config $f"
    done

    if fallback_is_uki; then
        local src="$LIMINE_PKG_EFI"
        sudo test -f /boot/EFI/BOOT/BOOTX64.LIMINE.EFI.unused && src=/boot/EFI/BOOT/BOOTX64.LIMINE.EFI.unused
        sudo test -f "$src" || { warn "no Limine binary found to restore (looked in $LIMINE_PKG_EFI)"; return 1; }
        say "restoring Limine at the EFI fallback (was a UKI copy)"
        sudo cp -f "$FALLBACK_PATH" /boot/EFI/BOOT/BOOTX64.UKI-bypass.backup
        sudo cp -f "$src" "$FALLBACK_PATH"
    fi

    say "installing the ESP hygiene hook"
    sudo install -m755 "${SCRIPT_DIR}/95-limine-esp-hygiene" "$HYGIENE_HOOK"
    sudo sync
    say "done — the boot menu will now show on every boot route"
}

mod_boot_remove() {
    # The repaired layout is what stock Omarchy installs, so there is nothing
    # sensible to "undo" there; only the hook is ours to take back.
    sudo rm -f "$HYGIENE_HOOK"
    say "hygiene hook removed; the ESP layout is left as stock Omarchy installs it"
    warn "to restore the old UKI-over-fallback bypass: sudo cp /boot/EFI/BOOT/BOOTX64.UKI-bypass.backup ${FALLBACK_PATH}"
}

# ═══════════════════════ module: 5k ════════════════════════════════════════
mod_5k_title() { echo "Native 5K display"; }
mod_5k_tier()  { echo boot; }
mod_5k_desc()  { echo "Wakes the panel's second tile, stitches both into one 5120x2880 output and genlocks them. Rebuilds the amdgpu module for the kernel you will boot (stock module backed up)."; }
# The stock backup sits next to the module we installed, so its presence is how
# we tell a patched kernel tree from an untouched one -- for any kernel, not
# just the running one.
amdgpu_patched_for() {   # amdgpu_patched_for <kernelrelease>
    [[ -n "$(find "/usr/lib/modules/$1/kernel/drivers/gpu/drm/amd" -name 'amdgpu.ko*.stock-backup' 2>/dev/null | head -1)" ]]
}
mod_5k_detect() {
    local swapped=0 conf=0 live=0 res=""
    amdgpu_patched_for "$KREL" && swapped=1
    grep -q 'amdgpu.tiled_stitch=1' "$LIMINE_DEFAULT" 2>/dev/null && conf=1
    grep -q 'amdgpu.tiled_stitch=1' /proc/cmdline 2>/dev/null && live=1
    command -v hyprctl >/dev/null && res="$(hyprctl monitors 2>/dev/null | grep -oE '5120x2880' | head -1)"
    # A pending kernel we have not built for is not "applied": the next boot
    # loses 5K. Report partial so the menu offers it and --apply does not skip.
    if kernel_pending && ! amdgpu_patched_for "$TARGET_KREL"; then echo partial
    elif (( swapped && conf && live )) && [[ "$res" == "5120x2880" ]]; then echo applied
    elif (( swapped || conf || live )); then echo partial
    else echo not-applied; fi
}
mod_5k_preflight() {
    local ok=1 missing=() pkgs=()
    if [[ " $SUPPORTED_5K_SERIES " != *" $TARGET_KSERIES "* ]]; then
        warn "kernel ${TARGET_KREL}: the 5K patch is verified only for series ${SUPPORTED_5K_SERIES}."
        warn "It needs re-porting by hand first (see patches/README.md RULE 1)."
        ok=0
    else
        say "kernel ${TARGET_KREL} — supported"
    fi
    kernel_pending && say "building for ${TARGET_KREL}, not the running ${KREL} — it takes effect on reboot"
    # Build dependencies. The underlying installer only checks gcc, so a missing
    # bc/pahole surfaces as a confusing failure 20 minutes into a compile.
    local t
    for t in gcc make ld bc pahole flex bison zstd curl tar; do
        command -v "$t" >/dev/null || missing+=("$t")
    done
    if (( ${#missing[@]} )); then
        warn "missing build tools: ${missing[*]}"
        for t in "${missing[@]}"; do case $t in
            gcc|make|ld|flex|bison) pkgs+=(base-devel) ;;
            *)                      pkgs+=("$t") ;;
        esac; done
        # de-duplicate
        mapfile -t pkgs < <(printf '%s\n' "${pkgs[@]}" | sort -u)
        say "install with:  sudo pacman -S --needed ${pkgs[*]}"
        if confirm "Install them now?"; then
            sudo pacman -S --needed --noconfirm "${pkgs[@]}" || ok=0
        else ok=0; fi
    else
        say "build tools present"
    fi
    if [[ -e "/usr/lib/modules/${TARGET_KREL}/build/Module.symvers" ]]; then
        say "kernel headers present"
    else
        warn "linux-headers missing for ${TARGET_KREL}"
        if confirm "Install linux-headers now?"; then
            sudo pacman -S --needed --noconfirm linux-headers || ok=0
        else ok=0; fi
    fi
    local free_gb
    free_gb=$(df --output=avail -BG "$HOME" 2>/dev/null | tail -1 | tr -dc 0-9)
    if (( ${free_gb:-0} >= 8 )); then say "disk space: ${free_gb}G free"
    else warn "only ${free_gb:-?}G free — the kernel source tree needs roughly 8G"; ok=0; fi
    # A pre-populated tree makes this minutes instead of tens of minutes.
    if [[ -d "${HOME}/.cache/kernel-5k-build/linux-${TARGET_KREL%%-*}" ]]; then
        say "kernel source already prepared — build will be quick"
    else
        say "kernel source will be downloaded (~150M) and built: expect 20-40 min"
    fi
    return $(( 1 - ok ))
}
mod_5k_apply() {
    mod_5k_preflight || { warn "preflight failed — nothing was changed."; return 1; }
    printf '\n\033[1mRestore at any time:\033[0m  %s --remove 5k\n\n' "$0"
    confirm "Build and install the patched amdgpu module?" || return 1
    local log="$LOGDIR/apply-5k-$(date +%Y%m%d-%H%M%S).log"
    sudo "$INSTALLER_5K" --kernel "$TARGET_KREL" 2>&1 | tee "$log" || return 1
    if grep -q "$VIDEO_4K" "$LIMINE_DEFAULT" 2>/dev/null && confirm "Remove the 4K fallback parameter (required for real 5K)?"; then
        sudo cp "$LIMINE_DEFAULT" "${LIMINE_DEFAULT}.backup-pre5k-$(date +%s)"
        sudo sed -i "s| ${VIDEO_4K}||" "$LIMINE_DEFAULT"
    fi
    sync_boot_files && verify_cmdline 'amdgpu.tiled_stitch=1' "$VIDEO_4K"
    say "reboot to activate"
}
mod_5k_remove() {
    local k
    for k in "$KREL" "$TARGET_KREL"; do
        [[ $k == "$KREL" ]] || kernel_pending || continue
        amdgpu_patched_for "$k" || continue
        sudo "$INSTALLER_5K" --restore --kernel "$k" || return 1
    done
    if grep -q 'amdgpu.tiled_stitch=1' "$LIMINE_DEFAULT" 2>/dev/null; then
        sudo cp "$LIMINE_DEFAULT" "${LIMINE_DEFAULT}.backup-restore-$(date +%s)"
        sudo sed -i 's| amdgpu.tiled_stitch=1||' "$LIMINE_DEFAULT"
    fi
    if ! grep -q "$VIDEO_4K" "$LIMINE_DEFAULT" 2>/dev/null && confirm "Re-add the 4K fallback (recommended without 5K)?"; then
        sudo sed -i "s|\(KERNEL_CMDLINE\[default\]=\"[^\"]*\)\"|\1 ${VIDEO_4K}\"|" "$LIMINE_DEFAULT"
    fi
    sync_boot_files && verify_cmdline "" 'amdgpu.tiled_stitch=1'
    say "reboot to return to stock"
}

# ── boot helpers ───────────────────────────────────────────────────────────
#
# Limine >= 10.3.0 loads the FIRST config in its search order, so a copy at
# EFI/limine/ or EFI/BOOT/ silently overrides /boot/limine.conf -- the file
# limine-mkinitcpio and limine-snapper-sync actually maintain. Earlier versions
# of this script *created* those copies, believing the ESP needed three kept in
# sync. It does not, and the copies cost a Snapper snapshot its boot entry on
# 2026-09-05. `limine-install` flags them; the fix is to delete them.
LIMINE_SHADOW_CONFIGS=(
    /boot/EFI/limine/limine.conf
    /boot/EFI/BOOT/limine.conf
    /boot/boot/limine/limine.conf
    /boot/limine/limine.conf
)
UKI_PATH=/boot/EFI/Linux/omarchy_linux.efi
FALLBACK_PATH=/boot/EFI/BOOT/BOOTX64.EFI

remove_shadow_configs() {
    local f
    for f in "${LIMINE_SHADOW_CONFIGS[@]}"; do
        sudo test -f "$f" || continue
        sudo rm -f "$f" && say "removed shadowing config $f"
    done
    return 0
}

# True when the EFI fallback is a UKI copy rather than the Limine binary.
# NB: `objcopy --only-section=X` exits 0 even when section X is absent -- it
# writes nothing. Testing its exit status calls every PE binary a UKI, which on
# a stock ESP means overwriting Limine with a kernel image. Check for bytes.
fallback_is_uki() {
    sudo bash -c 'p=$(mktemp); trap "rm -f $p" EXIT
        objcopy -O binary --only-section=.cmdline '"$FALLBACK_PATH"' "$p" 2>/dev/null
        [[ -s $p ]]' 2>/dev/null
}

sync_boot_files() {
    say "rebuilding UKI"
    sudo limine-mkinitcpio || return 1
    remove_shadow_configs
    # Only relevant on machines still running the old "UKI over the fallback"
    # bypass; on a stock ESP that path is Limine and must not be touched.
    if fallback_is_uki; then
        say "refreshing UKI-bypass fallback ${FALLBACK_PATH}"
        sudo cp -f "$UKI_PATH" "$FALLBACK_PATH" 2>/dev/null
    fi
    sudo sync
}
verify_cmdline() {   # $1 must be present, $2 must be absent
    # Read the UKI itself, not the EFI fallback: on a stock ESP the fallback is
    # the Limine binary and carries no .cmdline at all.
    local line
    line="$(sudo bash -c 'tmp=$(mktemp); trap "rm -f $tmp" EXIT; objcopy -O binary --only-section=.cmdline '"$UKI_PATH"' "$tmp" && tr -d "\0" < "$tmp"')"
    [[ -n "${1:-}" ]] && ! grep -q "$1" <<<"$line" && { warn "verify: embedded cmdline missing '$1'"; return 1; }
    [[ -n "${2:-}" ]] &&   grep -q "$2" <<<"$line" && { warn "verify: embedded cmdline still has '$2'"; return 1; }
    say "embedded cmdline verified"
}

# ── generic driver ─────────────────────────────────────────────────────────
state_label() {
    case "$1" in
        applied)     printf '\033[1;32m✓ applied\033[0m' ;;
        not-applied) printf '\033[0;37m· not applied\033[0m' ;;
        partial)     printf '\033[1;33m⚠ partial\033[0m' ;;
        n/a)         printf '\033[0;37m— n/a\033[0m' ;;
    esac
}
# After a kernel upgrade the machine will boot a kernel whose modules we have
# not built yet. Say so loudly, while there is still time to build them.
kernel_banner() {
    kernel_pending || return 0
    local gaps=()
    amdgpu_patched_for "$TARGET_KREL"      || gaps+=(5k)
    audio_installed_is_ours "$TARGET_KREL" || gaps+=(audio)
    warn "kernel ${TARGET_KREL} is installed; you are running ${KREL}. A reboot is pending."
    if (( ${#gaps[@]} )); then
        warn "not built for it yet: ${gaps[*]} — apply these BEFORE you reboot:"
        printf '     %s --apply %s\n' "$0" "${gaps[*]}"
    else
        say "5K and audio are already built for ${TARGET_KREL} — safe to reboot."
    fi
    echo
}
show_status() {
    hdr "imac-patcher — ${product}, kernel ${KREL}"
    kernel_banner
    local m st tier
    for m in "${MODULES[@]}"; do
        st="$("mod_${m}_detect")"; tier="$("mod_${m}_tier")"
        printf '  %-32s %-22b %s\n' "$("mod_${m}_title")" "$(state_label "$st")" \
            "$(case $tier in boot) printf '\033[0;33m[boot]\033[0m';; tweak) printf '\033[0;36m[tweak]\033[0m';; esac)$(has_update "$m" && printf ' \033[1;35m↑ update\033[0m')"
    done
    echo
    printf '  ids: %s\n' "${MODULES[*]}"
}
# The menu asks for every module's state each time it opens, and a full sweep
# costs most of a second (dkms, pactl, hyprctl). Answer from a cache that one
# sweep fills, so the first row pays and the rest are free.
STATE_CACHE="${HOME}/.cache/imac-patcher/state"
# Which tweaked plugins have an update waiting. Filled by --check-updates,
# which talks to the network and so is never run from a status query: the bar
# widget refreshes it on a long timer and everything else only reads it.
UPDATES_CACHE="${HOME}/.cache/imac-patcher/updates"
check_updates() {
    local m id d out=""
    for m in "${MODULES[@]}"; do
        declare -F "mod_${m}_appid" >/dev/null || continue
        id="$("mod_${m}_appid")"; d="$(app_dir "$id")"
        [[ -d $d/.git ]] || continue
        timeout 25 git -C "$d" fetch --quiet origin HEAD 2>/dev/null || continue
        [[ "$(git -C "$d" rev-parse HEAD)" == "$(git -C "$d" rev-parse FETCH_HEAD)" ]] || out+="${m}"$'\n'
    done
    mkdir -p "$(dirname "$UPDATES_CACHE")" && printf '%s' "$out" > "$UPDATES_CACHE"
}
has_update() { [[ -f $UPDATES_CACHE ]] && grep -qx "$1" "$UPDATES_CACHE"; }
state_cache_write() {
    local m out=""
    for m in "${MODULES[@]}"; do out+="${m} $("mod_${m}_detect")"$'\n'; done
    mkdir -p "$(dirname "$STATE_CACHE")" && printf '%s' "$out" > "$STATE_CACHE"
}
state_of() {   # <id>
    local age=99999 out
    [[ -f $STATE_CACHE ]] && age=$(( $(date +%s) - $(stat -c %Y "$STATE_CACHE" 2>/dev/null || echo 0) ))
    (( age > 10 )) && state_cache_write
    out="$(awk -v m="$1" '$1==m{print $2}' "$STATE_CACHE" 2>/dev/null)"
    # A module the cache has never seen -- one that has just registered from
    # another repo -- must not be reported as inapplicable; rebuild and re-ask.
    if [[ -z $out ]]; then
        state_cache_write
        out="$(awk -v m="$1" '$1==m{print $2}' "$STATE_CACHE" 2>/dev/null)"
    fi
    printf '%s\n' "${out:-n/a}"
}

# ── the Omarchy menu ───────────────────────────────────────────────────────
# Not a plugin: Omarchy reads ~/.config/omarchy/extensions/omarchy-menu.jsonc
# itself, watches it for changes, and evaluates each row's when:/checked: shell
# expression, so the menu is data rather than code we would have to keep
# working against Omarchy's internals. Rows are written between markers and
# regenerated in place, leaving anything the user added around them untouched.
# Both front ends read the same modules: this file is the only source of truth.
MENU_EXT="${HOME}/.config/omarchy/extensions/omarchy-menu.jsonc"
MENU_BEGIN='  // >>> imac-patcher — generated; run `imac-patcher --menu install` to refresh'
MENU_END='  // <<< imac-patcher'
# Menu rows are narrow: a long label is truncated and takes the checkmark with
# it, so each row gets a short name here and the module's full title becomes
# its description, which the menu also searches.
menu_label() {
    declare -F "mod_${1}_label" >/dev/null && { "mod_${1}_label"; return; }
    case $1 in
    audio) echo 'Speakers & mic' ;; eq)      echo 'Speaker EQ' ;;
    panel) echo 'Jack-aware panel' ;; color) echo 'Colour (P3)' ;;
    vram)  echo 'GPU memory guard' ;; wifi)  echo 'Wi-Fi fix' ;;
    suspend) echo 'Block suspend' ;; boot)   echo 'Boot hygiene' ;;
    5k)    echo 'Native 5K' ;; game)         echo 'Quiet game sounds' ;;
    news)  echo 'News Radar fix' ;; *)       echo "$1" ;;
    esac
}
menu_icon() {
    declare -F "mod_${1}_icon" >/dev/null && { "mod_${1}_icon"; return; }
    case $1 in
    audio) echo '󰋋' ;; eq) echo '󰋎' ;; panel) echo '󰓃' ;; color) echo '󰸊' ;;
    vram)  echo '󰢮' ;; wifi) echo '󰖩' ;; suspend) echo '󰤄' ;; boot) echo '󰸈' ;;
    5k)    echo '󰍹' ;; game) echo '󰊴' ;; news) echo '󰎕' ;; *) echo '󰏫' ;;
    esac
}
menu_block() {
    local m tier
    printf '%s\n' "$MENU_BEGIN"
    printf '  "imac": {"icon":"","label":"iMac","aliases":["imac","patches"],"description":"Hardware and app patches for this iMac"},\n'
    for m in "${MODULES[@]}"; do
        tier="$("mod_${m}_tier")"
        [[ $tier == tweak ]] && continue
        printf '  "imac.%s": {"icon":"%s","label":"%s","description":"%s","checked":"imac-patcher --is-applied %s","when":"imac-patcher --is-applicable %s","action":"omarchy-launch-floating-terminal-with-presentation '"'"'imac-patcher --toggle %s'"'"'"},\n' \
            "$m" "$(menu_icon "$m")" "$(menu_label "$m")" "$("mod_${m}_title")" "$m" "$m" "$m"
    done
    printf '  "imac.tweaks": {"icon":"","label":"Tweaks","description":"Patches to other people'"'"'s apps; each switches off by itself when the app moves on"},\n'
    for m in "${MODULES[@]}"; do
        [[ "$("mod_${m}_tier")" == tweak ]] || continue
        printf '  "imac.tweaks.%s": {"icon":"%s","label":"%s","description":"%s","checked":"imac-patcher --is-applied %s","when":"imac-patcher --is-applicable %s","action":"omarchy-launch-floating-terminal-with-presentation '"'"'imac-patcher --toggle %s'"'"'"},\n' \
            "$m" "$(menu_icon "$m")" "$(menu_label "$m")" "$("mod_${m}_title")" "$m" "$m" "$m"
    done
    printf '  "imac.tweaks.update": {"icon":"󰚰","label":"Update plugins","description":"Takes our patches off, updates, puts back the ones that still apply","action":"omarchy-launch-floating-terminal-with-presentation '"'"'imac-patcher --update-apps'"'"'"},\n'
    printf '  "imac.all": {"icon":"","label":"Open the patcher","action":"omarchy-launch-floating-terminal-with-presentation imac-patcher"},\n'
    printf '%s\n' "$MENU_END"
}
menu_splice() {   # <block-file>|"" — replace our block, or drop it when empty
    local blk="$1" tmp; tmp="$(mktemp)"
    [[ -f $MENU_EXT ]] || { mkdir -p "$(dirname "$MENU_EXT")"; printf '{\n}\n' > "$MENU_EXT"; }
    awk -v blk="$blk" '
        BEGIN { if (blk != "") { while ((getline l < blk) > 0) B = B l "\n" } }
        /^[[:space:]]*\/\/ >>> imac-patcher/ { skip = 1 }
        skip { if ($0 ~ /^[[:space:]]*\/\/ <<< imac-patcher/) skip = 0; next }
        { line[++n] = $0 }
        END {
            close_at = 0
            for (i = 1; i <= n; i++) if (line[i] ~ /^[[:space:]]*}[[:space:]]*$/) close_at = i
            for (i = 1; i <= n; i++) { if (i == close_at) printf "%s", B; print line[i] }
        }' "$MENU_EXT" > "$tmp" && mv "$tmp" "$MENU_EXT"
}
# ── the bar widget ─────────────────────────────────────────────────────────
# This one IS a plugin, because a bar widget has to be: Omarchy loads bar
# widgets as QML from ~/.config/omarchy/plugins/<id>/. It is a thin one --
# it asks `imac-patcher --list` what exists and calls `--toggle`, so the
# patcher stays the only thing that knows what a patch is.
# Both front ends invoke `imac-patcher` by name, so the symlink belongs to
# neither: it is put in place by either and taken away only when neither is left.
CLI_LINK="${HOME}/.local/bin/imac-patcher"
link_cli()   { install -d "$(dirname "$CLI_LINK")"; ln -sfn "$(readlink -f "${BASH_SOURCE[0]}")" "$CLI_LINK"; }
unlink_cli_if_unused() {
    [[ -d "${HOME}/.config/omarchy/plugins/ahmad.imac-patches" ]] && return 0
    grep -qs '>>> imac-patcher' "$MENU_EXT" && return 0
    rm -f "$CLI_LINK"
}

BAR_ID=ahmad.imac-patches
BAR_SRC="${REPO_DIR}/shell/${BAR_ID}"
BAR_DEST="${HOME}/.config/omarchy/plugins/${BAR_ID}"
SHELL_JSON="${HOME}/.config/omarchy/shell.json"
bar_in_layout() { jq -e --arg id "$BAR_ID" '[.bar.layout[]?[]?.id] | index($id) != null' "$SHELL_JSON" >/dev/null 2>&1; }
bar_install() {
    command -v jq >/dev/null || { warn "jq is needed to edit shell.json"; return 1; }
    install -d "$BAR_DEST"
    install -m644 "$BAR_SRC/manifest.json" "$BAR_SRC/BarWidget.qml" "$BAR_DEST/" || return 1
    link_cli
    if bar_in_layout; then
        say "already in the bar"
    else
        [[ -f $SHELL_JSON ]] || { warn "no $SHELL_JSON — open the bar once, then re-run"; return 1; }
        cp "$SHELL_JSON" "${SHELL_JSON}.bak-$(date +%s)"
        jq --arg id "$BAR_ID" '.bar.layout.right = ((.bar.layout.right // []) + [{"id":$id}])' \
            "$SHELL_JSON" > "${SHELL_JSON}.tmp" && mv "${SHELL_JSON}.tmp" "$SHELL_JSON" || return 1
        say "added to the right of the bar"
    fi
    state_cache_write
    restart_shell
}
bar_remove() {
    if [[ -f $SHELL_JSON ]] && bar_in_layout; then
        cp "$SHELL_JSON" "${SHELL_JSON}.bak-$(date +%s)"
        jq --arg id "$BAR_ID" '.bar.layout |= with_entries(.value |= map(select(.id != $id)))' \
            "$SHELL_JSON" > "${SHELL_JSON}.tmp" && mv "${SHELL_JSON}.tmp" "$SHELL_JSON"
    fi
    rm -rf "$BAR_DEST"
    unlink_cli_if_unused
    say "removed from the bar"
    restart_shell
}

menu_install() {
    local blk; blk="$(mktemp)"; menu_block > "$blk"
    menu_splice "$blk"; rm -f "$blk"
    link_cli
    state_cache_write
    say "added to the Omarchy menu under \"iMac\" — it appears without a restart"
    command -v imac-patcher >/dev/null || warn "~/.local/bin is not on PATH; the menu rows will not evaluate"
}
menu_remove() {
    menu_splice ""; unlink_cli_if_unused
    say "removed from the Omarchy menu"
}

# ── modules from elsewhere ─────────────────────────────────────────────────
# This repo carries the hardware. Patches to apps -- your own plugin fixes,
# anything you would rather keep to yourself -- live in their own repo and
# register it here, one path per line:
#
#     ~/.config/imac-patcher/module-dirs
#
# Each registered path is a repo root; every modules/*.sh under it is sourced
# with MODULE_ROOT set to that root, so a module can find its own patch files.
# A file only has to define mod_<id>_title/_tier/_desc/_detect/_apply/_remove --
# it is picked up by having a _detect, and joins the end of the list. Everything
# downstream (status, the bar widget, --toggle, --update-apps) then treats it
# exactly like a built-in, so there is one list and one patcher, not two.
MODULE_DIRS_FILE="${XDG_CONFIG_HOME:-$HOME/.config}/imac-patcher/module-dirs"
load_extra_modules() {
    local root f fn id
    if [[ -f $MODULE_DIRS_FILE ]]; then
        while IFS= read -r root; do
            root="${root%%#*}"; root="${root//[[:space:]]/}"
            [[ -n $root ]] || continue
            root="${root/#\~/$HOME}"
            [[ -d $root/modules ]] || { warn "registered module dir has no modules/: $root"; continue; }
            for f in "$root"/modules/*.sh; do
                [[ -f $f ]] || continue
                MODULE_ROOT="$root"
                # shellcheck disable=SC1090
                source "$f" || warn "could not load module $f"
            done
        done < "$MODULE_DIRS_FILE"
    fi
    while read -r fn; do
        id="${fn#mod_}"; id="${id%_detect}"
        [[ " ${MODULES[*]} " == *" $id "* ]] || MODULES+=("$id")
    done < <(declare -F | awk '{print $3}' | grep -E '^mod_[A-Za-z0-9_]+_detect$')
}

run_module() {   # $1 = apply|remove, $2 = id
    local action=$1 id=$2 st
    st="$("mod_${id}_detect")"
    [[ $st == n/a ]] && { say "${id}: not applicable on this machine — skipping"; return 0; }
    if [[ $action == apply && $st == applied ]]; then say "${id}: already applied — skipping"; return 0; fi
    if [[ $action == remove && $st == not-applied ]]; then say "${id}: not applied — nothing to remove"; return 0; fi
    hdr "$( [[ $action == apply ]] && echo Applying || echo Removing ): $("mod_${id}_title")"
    if "mod_${id}_${action}"; then
        say "${id}: ${action} finished — now $("mod_${id}_detect")"
    else
        warn "${id}: ${action} failed (see messages above)"; return 1
    fi
}

load_extra_modules

case "${1:-}" in
    --status) show_status; exit 0 ;;

    # One tab-separated row per module, for the bar widget: id, tier, state,
    # short name, full title, icon, and whether that plugin has an update
    # waiting. A bar popup is narrow, so the row shows the short
    # name and keeps the title for the tooltip. Same cache as the menu uses.
    --list)
        for m in "${MODULES[@]}"; do
            printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\n' "$m" "$("mod_${m}_tier")" "$(state_of "$m")" \
                "$(menu_label "$m")" "$("mod_${m}_title")" "$(menu_icon "$m")" \
                "$(has_update "$m" && echo update || echo -)"
        done
        exit 0 ;;

    # Cheap queries, for the Omarchy menu's when:/checked: expressions.
    --state)         state_of "${2:-}"; exit 0 ;;
    --is-applied)    [[ "$(state_of "${2:-}")" == applied ]]; exit $? ;;
    --is-applicable) [[ "$(state_of "${2:-}")" != n/a ]];     exit $? ;;

    --check-updates)
        check_updates
        if [[ -s $UPDATES_CACHE ]]; then say "update waiting for: $(tr '\n' ' ' < "$UPDATES_CACHE")"
        else say "every tweaked plugin is up to date"; fi
        exit 0 ;;

    --toggle)
        id="${2:-}"
        [[ " ${MODULES[*]} " == *" $id "* ]] || { echo "unknown module: $id" >&2; exit 2; }
        case "$("mod_${id}_detect")" in
            applied) run_module remove "$id" ;;
            n/a)     warn "$("mod_${id}_title"): not applicable right now — nothing to do" ;;
            *)       run_module apply  "$id" ;;
        esac
        state_cache_write
        exit 0 ;;

    --update-apps)
        # A patched plugin blocks its own update: omarchy fast-forwards and
        # aborts on modified tracked files. So take our patches off, update,
        # and put back only the ones that still apply — a patch that no longer
        # applies is one upstream has most likely fixed, and it stays off.
        shift
        # With no arguments this covers every tweak; name one or more module
        # ids to update just those plugins and leave the rest alone.
        declare -a want=("$@") restore=() plugins=()
        for m in "${want[@]}"; do
            [[ " ${MODULES[*]} " == *" $m "* ]] || { warn "unknown module: $m"; exit 2; }
            declare -F "mod_${m}_appid" >/dev/null || { warn "${m} does not patch a plugin"; exit 2; }
            plugins+=("$("mod_${m}_appid")")
        done
        for m in "${MODULES[@]}"; do
            declare -F "mod_${m}_appid" >/dev/null || continue
            (( ${#want[@]} )) && [[ " ${want[*]} " != *" $m "* ]] && continue
            [[ "$("mod_${m}_detect")" == applied ]] || continue
            restore+=("$m"); say "unpatching ${m} so it can update"; "mod_${m}_remove"
        done
        # omarchy-plugin-update prints the incoming diff and asks. Without
        # delta installed that diff goes through git's pager, so it stops on a
        # ":" prompt waiting for q -- one keypress too many when the update was
        # already asked for by clicking. Show the diff inline and keep the
        # confirmation, which is the part actually worth answering.
        GIT_PAGER=cat PAGER=cat omarchy-plugin-update "${plugins[@]}" \
            || warn "plugin update reported a problem"
        for m in "${restore[@]}"; do
            case "$("mod_${m}_detect")" in
                not-applied) run_module apply "$m" ;;
                applied)     : ;;
                *) warn "${m}: the patch no longer fits this version — left off (upstream may already carry it)" ;;
            esac
        done
        state_cache_write; check_updates; exit 0 ;;

    --bar)
        case "${2:-}" in
            install) bar_install ;;
            remove)  bar_remove ;;
            *) echo "usage: $0 --bar install|remove" >&2; exit 2 ;;
        esac
        exit 0 ;;

    --menu)
        case "${2:-}" in
            install) menu_install ;;
            remove)  menu_remove ;;
            *) echo "usage: $0 --menu install|remove" >&2; exit 2 ;;
        esac
        exit 0 ;;
    --apply|--remove)
        action="${1#--}"; shift
        [[ ${1:-} == safe ]] && { set -- ; for m in "${MODULES[@]}"; do [[ $("mod_${m}_tier") == safe ]] && set -- "$@" "$m"; done; }
        (( $# )) || { echo "usage: $0 --${action} <id...|safe>   ids: ${MODULES[*]}" >&2; exit 2; }
        for id in "$@"; do
            [[ " ${MODULES[*]} " == *" $id "* ]] || { warn "unknown module: $id"; continue; }
            run_module "$action" "$id"
        done
        exit 0 ;;
    --force|"") ;;
    *) echo "usage: $0 [--status | --apply <id...|safe> | --remove <id...|safe> | --toggle <id> | --update-apps [id...] | --check-updates | --bar install|remove | --menu install|remove]"; exit 2 ;;
esac

# ── interactive ────────────────────────────────────────────────────────────
show_status
echo
if ((HAVE_GUM)); then
    sel=$(gum choose "Apply all safe patches" "Choose patches to apply" "Remove a patch" "Quit")
else
    select sel in "Apply all safe patches" "Choose patches to apply" "Remove a patch" "Quit"; do break; done
fi
case "$sel" in
    "Apply all safe patches")
        for m in "${MODULES[@]}"; do
            [[ $("mod_${m}_tier") == safe ]] || continue
            [[ $("mod_${m}_detect") == applied ]] && continue
            run_module apply "$m"
        done ;;
    "Choose patches to apply")
        avail=(); for m in "${MODULES[@]}"; do
            st=$("mod_${m}_detect"); [[ $st == applied || $st == n/a ]] && continue
            avail+=("${m} — $("mod_${m}_title")$([[ $("mod_${m}_tier") == boot ]] && echo '  [boot]')")
        done
        (( ${#avail[@]} )) || { say "everything applicable is already applied"; exit 0; }
        if ((HAVE_GUM)); then picks=$(gum choose --no-limit "${avail[@]}"); else
            select p in "${avail[@]}"; do picks=$p; break; done; fi
        while read -r line; do [[ -n $line ]] && run_module apply "${line%% *}"; done <<<"$picks" ;;
    "Remove a patch")
        avail=(); for m in "${MODULES[@]}"; do
            [[ $("mod_${m}_detect") =~ ^(applied|partial)$ ]] && avail+=("${m} — $("mod_${m}_title")")
        done
        (( ${#avail[@]} )) || { say "nothing to remove"; exit 0; }
        if ((HAVE_GUM)); then pick=$(gum choose "${avail[@]}"); else
            select p in "${avail[@]}"; do pick=$p; break; done; fi
        [[ -n ${pick:-} ]] && run_module remove "${pick%% *}" ;;
    *) exit 0 ;;
esac
