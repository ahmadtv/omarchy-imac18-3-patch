#!/usr/bin/env bash
# Run right after login, BEFORE touching the headphone jack. Reports whether the
# internal mic delivers signal and what each layer thinks, so a dead-at-boot mic
# can be pinned to the driver, ALSA, or the session manager.
S=alsa_input.pci-0000_00_1f.3.analog-stereo
echo "uptime: $(uptime -p)   time: $(date +%T)"
echo "driver capture source : $(amixer -c0 cget numid=1 | grep ': values' | cut -d= -f2)  (0=Internal 1=jack)"
echo "ALSA Internal Mic     : $(amixer -c0 sget 'Internal Mic' | grep -m1 -oE 'Capture [0-9]+ \[[0-9]+%\].*')"
echo "PipeWire input ports  :"; pactl -f json list sources 2>/dev/null | jq -r --arg s "$S" '.[] | select(.name == $s) | .active_port as $a | .ports[] | "   \(.description) active=\(.name == $a) avail=\(.availability)"'
echo "PipeWire source volume: $(pactl get-source-volume "$S" | head -1 | awk '{print $5}')  mute: $(pactl get-source-mute "$S" | awk '{print $2}')"
f=$(mktemp --suffix=.wav); timeout 5 pw-record --target "$S" "$f" & sleep 2.5; kill %1 2>/dev/null; wait 2>/dev/null
python3 - "$f" <<'PY'
import wave,struct,sys
w=wave.open(sys.argv[1]);d=w.readframes(w.getnframes());n=w.getsampwidth()
s=struct.unpack('<%d%s'%(len(d)//n,'h' if n==2 else 'i'),d) if d else [0]; s=s[len(s)//4:] or [0]
nz=sum(1 for x in s if x); pk=max(abs(x) for x in s)/2**(8*n-1)
print("capture               : %s  (%d nonzero samples, peak %.1f%%)" % ("SIGNAL" if nz>len(s)//2 else "DIGITAL SILENCE", nz, 100*pk))
PY
rm -f "$f"

# The driver's own account of this boot: how it set capture up, and every jack
# event since. Without this a "dead until I cycled the jack" report cannot be
# pinned to the driver rather than to the session manager.
echo "--- driver, this boot (last 12 lines) ---"
journalctl -b 0 -k --no-pager 2>/dev/null | grep -i 'cs8409' | tail -12 | sed 's/.*hdaudioC0D0: /   /'
echo "--- jack events so far: $(journalctl -b 0 -k --no-pager 2>/dev/null | grep -c 'jack_unsol_event') ---"
