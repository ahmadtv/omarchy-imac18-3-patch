#!/usr/bin/env bash
#
# vce-reset-test — provoke a VCE encoder hang from a text console and report
# whether the GPU reset completes, instead of freezing the machine.
#
# Run from a TTY (Ctrl+Alt+F3) on the boot entry under test, never from the
# desktop: the reset kills the graphics session by design ("VRAM is lost"), so
# this first leaves the desktop (multi-user.target) and only then encodes.
#
#   sudo scripts/vce-reset-test            # uses the clip known to hang vce0
#   sudo scripts/vce-reset-test <video>
#
# Pass:  "GPU reset succeeded" in the kernel log and the shell still answers.
# Fail:  no "succeeded" within the wait, hung-task reports, or a dead box.
set -u
# Under sudo $HOME is /root; the clips live in the invoking user's home.
USER_HOME="$(getent passwd "${SUDO_USER:-$USER}" | cut -d: -f6)"
KEEP_DESKTOP=0; [[ ${1:-} == --keep-desktop ]] && { KEEP_DESKTOP=1; shift; }
# The exact sequence that hung vce0 on 2026-09-11 (third clip), same order.
CLIPS=("/path/to/clip-hevc10.mov"
       "/path/to/camera-4k-a.mp4"
       "/path/to/camera-4k-b.mp4"
       "/path/to/camera-4k-c.mp4")
(( $# )) && CLIPS=("$@")
ROUNDS=5
[[ $EUID -eq 0 ]] || { echo "run with sudo (it stops the graphical session)"; exit 1; }
for c in "${CLIPS[@]}"; do [[ -f $c ]] || { echo "no such clip: $c"; exit 1; }; done
say() { printf '\033[1;33m==>\033[0m %s\n' "$*"; }
klog() { journalctl -k --after-cursor="$CUR" -q --no-pager 2>/dev/null; }

say "amdgpu $(cat /sys/module/amdgpu/srcversion)"
if (( KEEP_DESKTOP )); then say "keeping the desktop running (it will die when the GPU resets)"
else say "leaving the desktop"; systemctl isolate multi-user.target; sleep 3; fi
CUR=$(journalctl -k -n0 --show-cursor -q --no-pager 2>/dev/null | sed -n 's/^-- cursor: //p')
OUT=$(mktemp /tmp/vce-test.XXXXXX.mp4)

hung=0
for r in $(seq 1 $ROUNDS); do
  for c in "${CLIPS[@]}"; do
    printf '  round %s  %-44s ' "$r" "$(basename "$c" | cut -c1-44)"
    timeout 90 ffmpeg -nostdin -v error -max_alloc 536870912 -max_pixels 50000000 -threads 1 -filter_threads 1 \
      -hwaccel vaapi -hwaccel_device /dev/dri/renderD128 -hwaccel_output_format vaapi \
      -i "$c" -map 0:v:0 -map '0:a:0?' -sn -dn -t 30 \
      -vf scale_vaapi=w=1280:h=1280:force_original_aspect_ratio=decrease:force_divisible_by=16:format=nv12 \
      -c:v h264_vaapi -fpsmax 30 -b:v 2M -maxrate 3M -bufsize 4M -c:a aac -b:a 96k \
      -movflags +frag_keyframe+empty_moov -f mp4 -y "$OUT" 2>/dev/null
    rc=$?; echo "exit $rc"
    if klog | grep -qE 'ring vce0 timeout'; then hung=1; break 2; fi
  done
done
rm -f "$OUT"

if (( hung )); then
  say "vce0 hung — waiting up to 90 s for the reset to finish"
  for i in $(seq 1 18); do klog | grep -qE 'GPU reset succeeded' && break; sleep 5; done
  echo; klog | grep -E 'ring .* timeout|GPU reset|VRAM is lost|blocked for more than|succeeded|failed' | sed -E 's/^.*kernel: +/  /' | head -20; echo
  if klog | grep -qE 'GPU reset succeeded' && ! klog | grep -q 'blocked for more than'; then
    say "PASS: vce0 hung and the reset completed — the machine recovered"
  else say "FAIL: vce0 hung and the reset did not complete"; fi
else
  say "NO HANG in $ROUNDS rounds of ${#CLIPS[@]} clips — try:  sudo $0 --keep-desktop"
fi
say "reboot with:  systemctl reboot"
