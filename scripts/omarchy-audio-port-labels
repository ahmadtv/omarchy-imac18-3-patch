#!/bin/bash

# omarchy:summary=Print the active port of every audio device that has more than one
# omarchy:group=audio

# A laptop's speakers and its headphone jack are one device to PipeWire, with a
# port for each: plugging headphones in switches the port, never the device. So
# the device name cannot change, and a panel that labels devices says "Built-in
# Audio" whether the sound is coming out of the speakers or the jack. The port
# is what a person means by "the output" -- Speakers, Headphones, Internal
# Microphone, Headset Microphone -- and it is what macOS shows.
#
# Prints <node name><TAB><active port description> for every sink and source
# that has a choice. A device with a single port is best named by the device,
# so it is not listed.

for kind in sinks sources; do
  pactl list "$kind" 2>/dev/null | awk '
    function emit() {
      if (name != "" && ports > 1 && active != "") print name "\t" active
    }

    /^(Sink|Source) #/ { emit(); name = ""; ports = 0; active = ""; in_ports = 0; next }
    /^[[:space:]]*Name:/ { name = $2; if (name ~ /\.monitor$/) name = ""; next }
    /^[[:space:]]*Ports:$/ { in_ports = 1; next }

    # "\t\tanalog-output-headphones: Headphones (type: Headphones, ...)"
    in_ports && /^\t\t[^\t]/ {
      ports++
      line = $0; sub(/^\t\t/, "", line)
      id = line; sub(/:.*/, "", id)
      desc = line; sub(/^[^:]*: /, "", desc); sub(/ \(type:.*$/, "", desc)
      port[id] = desc
      next
    }
    /^\tActive Port:/ { in_ports = 0; active = port[$3]; next }

    END { emit() }
  '
done
