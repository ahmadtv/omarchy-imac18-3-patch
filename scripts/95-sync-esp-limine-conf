#!/usr/bin/env bash
#
# 95-sync-esp-limine-conf — install to /etc/boot/hooks/post.d/
#
# This ESP carries three copies of limine.conf:
#
#   /boot/limine.conf              ESP root — the one the tools regenerate
#   /boot/EFI/limine/limine.conf   next to limine_x64.efi — the one Limine READS
#   /boot/EFI/BOOT/limine.conf     beside the fallback loader
#
# limine-mkinitcpio and limine-snapper-sync only ever write the ESP-root copy.
# Nothing in the stock packages propagates it, so every kernel update and every
# new Snapper snapshot leaves the copy Limine actually reads behind. The visible
# symptom is a snapshot that exists in `snapper list` and in /boot/limine.conf
# but never appears in the boot menu — which is exactly what happened here on
# 2026-09-05: snapshot 3 was created at 18:58 and the ESP copies still dated
# from 2026-09-04.
#
# Both tools run /etc/boot/hooks/post.d/*, so syncing here covers both.
#
# The same staleness bites \EFI\BOOT\BOOTX64.EFI, which on this machine is a
# COPY of the UKI rather than the Limine binary (an older bypass). If the
# firmware takes that fallback path it boots whatever UKI was current when the
# copy was made — it was found two days stale after a module rebuild. Refresh it
# too, but only when it really is a UKI copy; never clobber a Limine binary.
#
# Exit codes: the hook runner treats >=100 as fatal and aborts the caller.
# Nothing here is worth aborting a kernel install over, so we always exit 0 and
# just warn.

set -uo pipefail

ESP=/boot
SRC="${ESP}/limine.conf"
UKI="${ESP}/EFI/Linux/omarchy_linux.efi"
FALLBACK="${ESP}/EFI/BOOT/BOOTX64.EFI"

warn() { printf '95-sync-esp-limine-conf: %s\n' "$*" >&2; }

[[ -f $SRC ]] || exit 0

for dest in "${ESP}/EFI/limine/limine.conf" "${ESP}/EFI/BOOT/limine.conf"; do
	[[ -d $(dirname "$dest") ]] || continue
	cmp -s "$SRC" "$dest" && continue
	if cp -f "$SRC" "$dest"; then
		printf '95-sync-esp-limine-conf: refreshed %s\n' "$dest"
	else
		warn "could not refresh $dest"
	fi
done

# Only touch the fallback when it is already a UKI copy — never when it is the
# Limine binary, which is what stock Omarchy puts there.
#
# NB: `objcopy --only-section=X` EXITS 0 even when section X does not exist; it
# just writes nothing. Testing its exit status therefore treats every PE binary
# as a UKI, and the hook happily overwrites Limine with a kernel image. Extract
# and check that we actually got bytes.
is_uki=0
if [[ -f $FALLBACK ]]; then
	probe="$(mktemp)"
	objcopy -O binary --only-section=.cmdline "$FALLBACK" "$probe" 2>/dev/null || true
	[[ -s $probe ]] && is_uki=1
	rm -f "$probe"
fi

if [[ -f $UKI && $is_uki -eq 1 ]] && ! cmp -s "$UKI" "$FALLBACK"; then
	if cp -f "$UKI" "$FALLBACK"; then
		printf '95-sync-esp-limine-conf: refreshed %s from the current UKI\n' "$FALLBACK"
	else
		warn "could not refresh $FALLBACK"
	fi
fi

sync
exit 0
