#!/usr/bin/env bash
#
# imac-test-entry — boot a risky amdgpu build from its own Limine entry, so the
# default entry always stays on something known to work.
#
# The problem this solves: installing a patched amdgpu module overwrites the
# live one and rebuilds the UKI in place. If the new module is bad you have no
# "boot the old one" option — only a full subvolume rollback or a USB stick.
# Snapper snapshots don't fill the gap either: they're read-only, so they give
# you a rescue shell rather than a working desktop.
#
# Instead:
#
#   default entry  ->  omarchy_linux.efi          (known-good module)
#   test entry     ->  omarchy_linux-5ktest.efi   (the build under test)
#
# The module is baked into the initramfs (MODULES=(amdgpu) + the kms hook), so
# whichever entry you pick decides which module loads. If the test entry
# misbehaves, reboot and take the default — nothing to restore.
#
# The test entry is appended to limine.conf by hand. limine.conf is fully
# auto-generated, so a kernel update or any limine-mkinitcpio run drops the
# entry. That is the intended failure direction: what you lose is the test,
# and what you keep is a known-good default.
#
#   imac-test-entry stage <known-good-amdgpu.ko.zst>
#       Current UKI becomes the test entry. The module you name is installed as
#       the default and the default UKI is rebuilt around it.
#
#   imac-test-entry promote      Test build becomes the permanent default.
#   imac-test-entry drop         Discard the test build; keep the default.
#   imac-test-entry status       What each entry currently boots.
#
set -euo pipefail

KREL="$(uname -r)"
MODDIR="/usr/lib/modules/${KREL}/kernel/drivers/gpu/drm/amd/amdgpu"
MODULE="${MODDIR}/amdgpu.ko.zst"
ESP=/boot
UKI="${ESP}/EFI/Linux/omarchy_linux.efi"
TESTUKI="${ESP}/EFI/Linux/omarchy_linux-5ktest.efi"
CONF="${ESP}/limine.conf"
MARKER="/Test - 5K boot fixes"

say() { printf '\033[1;33m==>\033[0m %s\n' "$*"; }
die() { printf '\033[1;31mERROR:\033[0m %s\n' "$*" >&2; exit 1; }

need_root() { [[ $EUID -eq 0 ]] || die "run with sudo: sudo $0 $*"; }

# Every limine.conf copy on this ESP must stay identical — the firmware may read
# any of them, and a stale copy boots a stale kernel.
sync_conf() {
	cp -f "$CONF" "${ESP}/EFI/BOOT/limine.conf" 2>/dev/null || true
	cp -f "$CONF" "${ESP}/EFI/limine/limine.conf" 2>/dev/null || true
	sync
}

# Limine pins each image by BLAKE2B-512 and this config sets
# hash_mismatch_panic: yes, so an entry whose hash drifts refuses to boot.
uki_hash() { b2sum "$1" | cut -d' ' -f1; }

has_test_entry() { grep -qF "$MARKER" "$CONF" 2>/dev/null; }

remove_test_entry() {
	[[ -f $CONF ]] || return 0
	# Drop from the marker line to end of file — the entry is always appended
	# last, after everything limine-entry-tool generates.
	sed -i "/^${MARKER//\//\\/}/,\$d" "$CONF"
	# Trim the blank lines the append left behind.
	printf '%s\n' "$(cat "$CONF")" > "$CONF"
	sync_conf
}

append_test_entry() {
	local hash cmdline
	hash="$(uki_hash "$TESTUKI")"
	cmdline="$(grep -m1 '^  cmdline:' "$CONF" | sed 's/^  cmdline: //')"
	[[ -n $cmdline ]] || die "could not read a cmdline from $CONF"

	cat >> "$CONF" <<EOF

${MARKER} (remove after confirming)
### Added by imac-test-entry. NOT auto-generated: a kernel update or any
### limine-mkinitcpio run drops this entry, leaving the known-good default.
protocol: efi
path: boot():/EFI/Linux/$(basename "$TESTUKI")#${hash}
cmdline: ${cmdline}
EOF
	sync_conf
}

rebuild_default_uki() {
	say "rebuilding the default UKI around the installed module"
	if command -v limine-mkinitcpio >/dev/null; then limine-mkinitcpio >/dev/null; else mkinitcpio -P >/dev/null; fi
	# The fallback path the firmware may take on its own must track the default.
	cp -f "$UKI" "${ESP}/EFI/BOOT/BOOTX64.EFI" 2>/dev/null || true
	sync_conf
}

# Pull amdgpu.ko.zst back out of a UKI's initramfs. This is what makes promote
# self-contained: the build under test is recovered from the image that was
# actually booted, not from a build tree that may have moved on since.
extract_module() {   # extract_module <uki> <dest>
	local img
	img="$(mktemp)"
	objcopy -O binary --only-section=.initrd "$1" "$img" 2>/dev/null \
		|| { rm -f "$img"; die "could not read an initramfs out of $1"; }
	bsdtar -xOf "$img" "usr/lib/modules/*/kernel/drivers/gpu/drm/amd/amdgpu/amdgpu.ko.zst" > "$2" 2>/dev/null \
		|| { rm -f "$img"; die "no amdgpu module inside $1"; }
	rm -f "$img"
	[[ -s $2 ]] || die "extracted an empty module from $1"
}

# Report which fixes a module carries, so status/promote can say what is what
# rather than just printing file sizes.
describe_module() {  # describe_module <path-to-.ko.zst>
	local ko syms marks=()
	ko="$(mktemp)"
	zstd -dcf "$1" > "$ko" 2>/dev/null || { rm -f "$ko"; echo "unreadable"; return; }
	# NB: capture then match. "strings ... | grep -q" is unsafe under
	# `set -o pipefail`: grep -q exits on the first match, strings takes
	# SIGPIPE, and pipefail then reports the pipeline as failed even though
	# the match succeeded — so every module reads as "stock".
	syms="$(strings "$ko" 2>/dev/null || true)"
	rm -f "$ko"
	[[ $syms == *tiled_stitch* ]]                 && marks+=("5K stitch")
	[[ $syms == *"panel latch teardown"* ]]       && marks+=("latch teardown")
	[[ $syms == *"forcing initial modeset"* ]]    && marks+=("early modeset")
	((${#marks[@]})) && (IFS=', '; echo "${marks[*]}") || echo "stock"
}

case "${1:-status}" in

stage)
	need_root "$@"
	GOOD="${2:-}"
	[[ -f ${GOOD:-} ]] || die "usage: sudo $0 stage <known-good-amdgpu.ko.zst>
The current UKI is treated as the build under test; the module you name here
becomes the default. Typical source: the .prev-5k or .stock-backup kept beside
the installed module."
	[[ -f $UKI ]] || die "no UKI at $UKI"

	say "staging the current UKI as the test entry"
	cp -f "$UKI" "$TESTUKI"

	say "installing the known-good module as the default"
	cp -f "$GOOD" "$MODULE"
	depmod "$KREL"

	rebuild_default_uki
	remove_test_entry
	append_test_entry

	say "done — default boots known-good, '$MARKER' boots the build under test"
	"$0" status
	;;

promote)
	need_root "$@"
	has_test_entry || die "no test entry present — nothing to promote"
	[[ -f $TESTUKI ]] || die "no test UKI at $TESTUKI"

	say "promoting the test build to the permanent default"
	tmp="$(mktemp)"
	extract_module "$TESTUKI" "$tmp"
	cp -f "$tmp" "$MODULE"
	rm -f "$tmp"
	depmod "$KREL"

	rebuild_default_uki
	remove_test_entry
	rm -f "$TESTUKI"

	say "done — the tested build is now the default; test entry removed"
	"$0" status
	;;

drop)
	need_root "$@"
	say "discarding the test build"
	remove_test_entry
	rm -f "$TESTUKI"
	say "done — default is unchanged and still known-good"
	"$0" status
	;;

status)
	printf '\n  \033[1mBoot entries\033[0m  (kernel %s)\n\n' "$KREL"

	if [[ -f $UKI ]]; then
		tmp="$(mktemp)"; extract_module "$UKI" "$tmp" 2>/dev/null || true
		printf '  %-26s %s\n' "default (Omarchy/linux)" "$([[ -s $tmp ]] && describe_module "$tmp" || echo '?')"
		rm -f "$tmp"
	fi

	if has_test_entry && [[ -f $TESTUKI ]]; then
		tmp="$(mktemp)"; extract_module "$TESTUKI" "$tmp" 2>/dev/null || true
		printf '  %-26s %s\n' "test entry" "$([[ -s $tmp ]] && describe_module "$tmp" || echo '?')"
		rm -f "$tmp"
	else
		printf '  %-26s %s\n' "test entry" "none"
	fi

	printf '\n  \033[1mRunning now\033[0m\n\n'
	printf '  %-26s %s\n' "loaded amdgpu" \
		"$(grep -qi 'panel latch teardown\|forcing initial modeset' <(journalctl -k -b 0 --no-pager 2>/dev/null) \
			&& echo 'test build (fix log lines present)' || echo 'no fix log lines this boot')"
	printf '\n'
	;;

*)
	die "unknown command '${1}'. Try: stage <module> | promote | drop | status"
	;;
esac
