[Unit]
Description=Keep the iMac speaker tuning off the headphone jack
Documentation=https://github.com/ahmadtv/omarchy-imac5k
# Needs the graph up: it reads the sink's active port and moves streams.
After=pipewire.service wireplumber.service omarchy-speaker-tuning.service
Wants=wireplumber.service
PartOf=pipewire.service

[Service]
Type=simple
ExecStart=%h/.local/bin/imac-audio-port-watch
Restart=on-failure
RestartSec=2

[Install]
WantedBy=graphical-session.target
